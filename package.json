{
  "name": "flt-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "FLT Exchange — non-custodial DEX trading platform",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @flt/db migrate:dev",
    "db:deploy": "pnpm --filter @flt/db migrate:deploy",
    "db:reset": "pnpm --filter @flt/db reset",
    "db:seed": "pnpm --filter @flt/db seed",
    "db:studio": "pnpm --filter @flt/db studio",
    "worker": "pnpm --filter @flt/worker start",
    "verify:tokens": "pnpm --filter @flt/db exec tsx ../../scripts/verify-tokens.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "opentype.js": "^2.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
