{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker name in the Cloudflare dashboard. If you deploy to a
  // differently-named Worker, change this — a mismatch is what produced the
  // "Service binding 'WORKER_SELF_REFERENCE' references Worker 'x' which was
  // not found" error.
  "name": "classifed2",

  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-03",

  // node:crypto (scrypt, hkdf, AES-GCM) and the pg driver both need this.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // --- Database -------------------------------------------------------------
  // Workers reach PostgreSQL either through Hyperdrive or a direct connection
  // string. src/server/db.ts prefers the HYPERDRIVE binding and falls back to
  // the DATABASE_URL secret.
  //
  // To use Hyperdrive, create one against your Postgres and uncomment:
  //
  //   "hyperdrive": [
  //     {
  //       "binding": "HYPERDRIVE",
  //       "id": "<your-hyperdrive-id>"
  //     }
  //   ]
  //
  // Caching MUST be left disabled on that Hyperdrive configuration. It is off
  // by default; do not turn it on. A cached read of a balance is a wrong
  // balance, and this application settles money on what it reads.
  //
  // Secrets (APP_SECRET, DATABASE_URL) are never committed. Set them with:
  //   npx wrangler secret put APP_SECRET
  //   npx wrangler secret put DATABASE_URL
}
