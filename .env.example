# ---------------------------------------------------------------------------
# FLTCrypto environment. Copy to `.env` and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
# Postgres. docker-compose publishes on 5433 to avoid clashing with a local 5432.
DATABASE_URL=postgresql://fltcrypto:fltcrypto_local_dev@localhost:5433/fltcrypto

# 32+ random bytes, base64. Generate: openssl rand -base64 48
# Used to sign session cookies and quote integrity tags.
APP_SECRET=

# --- Provider selection -----------------------------------------------------
# `mock` is the default everywhere. The app REFUSES to boot with NODE_ENV=production
# while any provider is still `mock` (see src/server/env.ts).
PAYMENT_PROVIDER=mock
LIQUIDITY_PROVIDER=mock
BLOCKCHAIN_PROVIDER=mock
KYC_PROVIDER=mock
DEX_PROVIDER=mock
SCREENING_PROVIDER=mock

# --- Quotes / risk ----------------------------------------------------------
QUOTE_TTL_SECONDS=30
# Max adverse move between quote and execution before the order is rejected+refunded.
EXECUTION_SLIPPAGE_TOLERANCE_BPS=50

# --- WAAFI Pay (PaymentProvider) --------------------------------------------
# PENDING-DOCS: the real adapter is NOT implemented. See src/providers/payment/waafi/README.md
# for the exact list of documentation and credentials required before it can be written.
# The variable names below are placeholders and MUST be reconciled against the real
# merchant API documentation before use.
WAAFI_API_BASE_URL=
WAAFI_MERCHANT_ID=
WAAFI_API_KEY=
WAAFI_API_SECRET=
WAAFI_WEBHOOK_SECRET=

# --- Liquidity venue --------------------------------------------------------
# PENDING-DOCS: venue not selected. See src/providers/liquidity/README.md
LIQUIDITY_API_BASE_URL=
LIQUIDITY_API_KEY=
LIQUIDITY_API_SECRET=

# --- KYC vendor -------------------------------------------------------------
# PENDING-DOCS: vendor not selected. See src/providers/kyc/README.md
KYC_API_BASE_URL=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# --- On-chain execution -----------------------------------------------------
# PENDING-DOCS: no aggregator has been chosen and no real adapter exists.
# See src/providers/dex/README.md. These names are ASSUMPTIONS.
DEX_AGGREGATOR_API_URL=
DEX_AGGREGATOR_API_KEY=
# Protected/private submission endpoint, to reduce MEV exposure. Falling back to
# the public mempool is a risk decision — see the DEX README.
DEX_PRIVATE_RPC_URL=
DEX_PUBLIC_RPC_URL=

# MPC/custody provider that signs treasury transactions. This system holds NO
# private keys; TreasuryWallet.custodian names who does.
CUSTODY_API_URL=
CUSTODY_API_KEY=

# Stablecoin the treasury swaps in and out of when sourcing on-chain.
SOURCING_STABLECOIN=USDC
# Default ceiling on acceptable price impact. Overridable per asset in the DB.
MAX_PRICE_IMPACT_BPS=100

# --- Blockchain analytics (ScreeningProvider) -------------------------------
# PENDING-DOCS: no vendor selected. See src/providers/screening/README.md.
# Screening runs on every crypto deposit and every withdrawal destination.
SCREENING_API_URL=
SCREENING_API_KEY=

# --- Mock tuning (development/test only) ------------------------------------
# Deterministic seed for mock provider price/fill behaviour.
MOCK_SEED=fltcrypto-dev
