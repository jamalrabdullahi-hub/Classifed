# ─────────────────────────────────────────────────────────────────────────────
# FLT Exchange — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml for local development.
DATABASE_URL=postgresql://flt:flt_dev_password@localhost:5433/flt_exchange?schema=public

# ── Secrets ─────────────────────────────────────────────────────────────────
# APP_SECRET signs and hashes session tokens. Minimum 32 characters.
APP_SECRET=replace-me-with-openssl-rand-base64-48-output-minimum-32-chars
# ENCRYPTION_KEY encrypts MFA secrets at rest. Must be exactly 32 bytes, base64.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-exactly-32-bytes-base64-encoded==

# ── Application URLs ────────────────────────────────────────────────────────
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# ── Chain / RPC ─────────────────────────────────────────────────────────────
# Base mainnet is the only chain enabled in Phase 1.
# The public RPC works for development. Use a keyed provider (Alchemy,
# QuickNode) in production — transaction monitoring polls continuously and
# public endpoints rate-limit.
BASE_RPC_URL=https://mainnet.base.org
# Optional fallback. A single RPC is a single point of failure for the whole
# execution path.
BASE_RPC_FALLBACK_URL=

# ── DEX aggregator ──────────────────────────────────────────────────────────
# Free key from https://dashboard.0x.org/create-account
# Without this, every real quote returns 401. Use DEX_ROUTER=mock to develop
# the UI without a key.
DEX_ROUTER=mock
ZEROEX_API_KEY=
ZEROEX_API_BASE_URL=https://api.0x.org

# ── FLT fees ────────────────────────────────────────────────────────────────
# The wallet that receives the integrator fee. Leave blank to run at 0 bps.
# 0x caps affiliate fees at 1000 bps (10%).
FLT_FEE_RECIPIENT_ADDRESS=

# ── Wallet connectivity ─────────────────────────────────────────────────────
# Free projectId from https://cloud.reown.com (formerly WalletConnect Cloud).
# Required for WalletConnect-compatible wallets. MetaMask works without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Market data ─────────────────────────────────────────────────────────────
MARKET_DATA_PROVIDER=mock
COINGECKO_API_KEY=

# ── KYC ─────────────────────────────────────────────────────────────────────
# Phase 1 ships manual review: the user submits, an administrator decides.
# The interface is ready for a real provider (Persona, Sumsub, Onfido).
KYC_PROVIDER=manual
KYC_API_BASE_URL=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# `console` prints verification and reset links to stdout for development.
MAIL_PROVIDER=console
MAIL_FROM_ADDRESS=no-reply@fltexchange.example
RESEND_API_KEY=

# ── Trading parameters ──────────────────────────────────────────────────────
# How long a firm quote stays valid before the user must re-quote.
QUOTE_TTL_SECONDS=30
# Default slippage tolerance applied to quotes, in basis points.
DEFAULT_SLIPPAGE_BPS=50
# Quotes worse than this are refused outright.
MAX_PRICE_IMPACT_BPS=500

# ── Worker ──────────────────────────────────────────────────────────────────
# How often the monitor polls for transaction receipts.
WORKER_POLL_INTERVAL_MS=5000
# Confirmations before a swap is treated as final.
WORKER_CONFIRMATIONS=2

# ── Price history (charts) ───────────────────────────────────────────────────
# Candles for the market charts. GeckoTerminal indexes the DEX pools themselves
# rather than exchange listings, so the chart shows the same liquidity a quote
# is routed through. Its public tier needs no key.
#   mock          deterministic synthetic candles, for development
#   geckoterminal real Base pool data
PRICE_HISTORY_PROVIDER=mock
# Cache lifetime for candles, as a fraction of the interval length. 0.25 means
# hourly candles are refetched at most every 15 minutes. The upstream free tier
# is rate limited across the whole deployment, not per user.
CANDLE_CACHE_RATIO=0.25

# ── Agentic trading ───────────────────────────────────────────────────────────
# Off by default everywhere. Turning it on means FLT holds a signing key for
# each participant who enables the agent — read the comment above
# AGENTIC_TRADING_ENABLED in packages/config/src/env.ts before setting this
# to true anywhere real money is at stake.
AGENTIC_TRADING_ENABLED=false
# 32 bytes, hex-encoded. Generate with: openssl rand -hex 32
# AGENT_KEY_ENCRYPTION_KEY=
AGENT_MAX_LEVERAGE_CAP=5
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Arbitrum RPC, used only by the agent-trading executor for Ostium orders and
# by the funding-verification endpoint. Nothing else on the platform reads
# Arbitrum directly.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
