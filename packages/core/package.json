{
  "name": "@flt/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./chains": "./src/chains/index.ts",
    "./services": "./src/services/index.ts",
    "./services/*": "./src/services/*.ts",
