// FLT Exchange — Phase 1 schema
//
// Two rules run through every model here:
//
//   1. This database RECORDS activity; it is never the source of truth for
//      customer balances. The chain is. Nothing here can move a user's assets.
//   2. Identifiers are UUIDv7, generated by the application. They are
//      time-ordered so rows cluster by insertion, and they are never sequential
//      integers exposed to a client.
//
// Token amounts are stored as decimal STRINGS in base units. A uint256 does not
// fit in any numeric type we have, and a float would silently lose precision on
// the one number that matters most. USD valuations use Decimal, and are always
// presented as estimates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// Lifecycle of a consumer account. Trading requires KYC_APPROVED.
enum AccountStatus {
  PENDING_KYC
  KYC_REQUIRED
  KYC_REVIEW
  KYC_APPROVED
  KYC_REJECTED
  SUSPENDED
}

/// Phase 2 hook. Read by the fee resolver and passed to the risk engine.
/// Carries no behaviour of its own in Phase 1.
enum AccountType {
  INVESTOR
  TRADER
  INSTITUTION
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum EmailTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum MfaMethod {
  TOTP
}

/// How much scrutiny a token has had. Nothing is presented as trusted merely
/// for existing on-chain.
enum TokenVerificationTier {
  /// Reviewed and approved by FLT. Tradeable by default.
  VERIFIED
  /// Known token from a reputable list, not individually reviewed.
  RECOGNIZED
  /// Present in the registry but explicitly flagged in the interface.
  UNVERIFIED
}

enum ProviderKind {
  DEX
  MARKET_DATA
  KYC
  MAIL
}

enum QuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REJECTED
}

enum TransactionKind {
  APPROVAL
  SWAP
}

enum TransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REVERTED
  DROPPED
  FAILED
}

enum PerpSide {
  LONG
  SHORT
}

enum PerpMarginMode {
  ISOLATED
  CROSS
}

/// Lifecycle of an order FLT prepared.
///
/// FLT does not submit orders, so it cannot observe a fill directly. PREPARED
/// means the order was specified and handed to the client; SUBMITTED means the
/// client reported sending it; FILLED and REJECTED are written by the worker
/// once the venue's own record is reconciled against it. ABANDONED is the
/// honest state for an order that was prepared and never reported back — the
/// user closed the tab, or declined the signature.
enum PerpOrderStatus {
  PREPARED
  SUBMITTED
  FILLED
  PARTIALLY_FILLED
  REJECTED
  ABANDONED
}

enum PerpOrderKind {
  OPEN
  CLOSE
  LEVERAGE_CHANGE
}

/// How an order reaches the book.
///
/// MARKET and LIMIT rest or cross immediately. The four trigger types sit off
/// the book until the mark reaches `triggerPrice`, then submit as a market or
/// limit order. A stop and a take-profit differ only in which side of the mark
/// the trigger sits, but they are named separately because confusing them is
/// how a protective stop becomes a profit-taker.
/// What a perpetual actually tracks.
///
/// A perp is a synthetic, so the underlying need not be a crypto asset: venues
/// list equity, index, FX and commodity perps that settle in stablecoins and
/// trade like any other contract. They behave differently in ways a trader has
/// to see — an FX pair moves in pips and trades around the clock on weekdays,
/// an equity mimic gaps over a weekend the crypto book trades straight through
/// — so the class is carried explicitly rather than guessed from a symbol.
enum PerpAssetClass {
  CRYPTO
  /// Tracks a listed equity.
  EQUITY
  /// Tracks an index or a dated future.
  FUTURE
  /// Tracks a currency pair.
  FOREX
  /// Tracks a physical commodity.
  COMMODITY
}

enum PerpOrderType {
  MARKET
  LIMIT
  STOP_MARKET
  STOP_LIMIT
  TAKE_PROFIT_MARKET
  TAKE_PROFIT_LIMIT
}

enum FeeType {
  PERCENTAGE
  FIXED
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum AdminRole {
  /// Read-only across the panel.
  VIEWER
  /// Day-to-day operations: suspend accounts, disable tokens and routes.
  OPERATOR
  /// KYC decisions.
  COMPLIANCE
  /// Everything, including administering other administrators.
  SUPER_ADMIN
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String        @id
  email            String        @unique
  /// Argon2id. Never logged, never returned by an API, never audited.
  passwordHash     String
  accountStatus    AccountStatus @default(PENDING_KYC)
  accountType      AccountType   @default(INVESTOR)
  emailVerifiedAt  DateTime?
  /// Set by an administrator. Independent of KYC so compliance and operations
  /// do not overwrite each other's decisions.
  tradingDisabled  Boolean       @default(false)
  /// Trading is a separate application: set when an administrator approves
  /// it, on top of approved identity verification. Null means not approved.
  tradingApprovedAt   DateTime?
  tradingApprovedById String?
  suspendedAt      DateTime?
  suspensionReason String?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions           UserSession[]
  devices            UserDevice[]
  mfaSecret          MfaSecret?
  recoveryCodes      MfaRecoveryCode[]
  emailTokens        EmailToken[]
  kycProfile         KycProfile?
  wallets            Wallet[]
  quotes             Quote[]
  transactions       Transaction[]
  perpOrders         PerpOrder[]
  perpPositions      PerpPositionSnapshot[]
  protectionPolicies ProtectionPolicy[]
  subscriptions      Subscription[]
  evcPayments        EvcPayment[]
  remittances        RemittanceOrder[]
  ledgerAccounts     LedgerAccount[]
  walletDelegation   WalletDelegation?
  fiatDeposits       FiatDeposit[]
  fiatWithdrawals   FiatWithdrawal[]
  custodyDeposits    CustodyDeposit[]
  withdrawals        Withdrawal[]
  referralCode       ReferralCode?          @relation("ReferralCodeOwner")
  referralsMade      Referral[]             @relation("ReferralsMade")
  referredBy         Referral?              @relation("ReferredBy")
  referralEarnings   ReferralEarning[]      @relation("ReferralEarnings")
  passiveCash        PassiveCashAccount?
  userAlgorithms     UserAlgorithm[]
  deletionRequests   AccountDeletionRequest[]
  createdAlgorithms  TradingAlgorithm[]

  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

model UserSession {
  id             String    @id
  userId         String
  /// SHA-256 of the opaque token. The token itself exists only in the cookie,
  /// so a database read cannot impersonate a user.
  tokenHash      String    @unique
  deviceId       String?
  ip             String?
  userAgent      String?
  /// A session that has passed the second factor. A session created during
  /// login but before the TOTP step is not yet usable.
  mfaSatisfiedAt DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserDevice {
  id          String    @id
  userId      String
  /// Stable fingerprint derived from user agent plus a long-lived cookie. Used
  /// to tell "a new device signed in" from "the same laptop again".
  fingerprint String
  label       String?
  userAgent   String?
  lastIp      String?
  trustedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("user_devices")
}

model MfaSecret {
  id              String    @id
  userId          String    @unique
  method          MfaMethod @default(TOTP)
  /// AES-256-GCM ciphertext. A database leak alone must not yield working
  /// second factors.
  secretEncrypted String
  /// Null until the user has proved they can generate a valid code.
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

model MfaRecoveryCode {
  id        String    @id
  userId    String
  /// Hashed like a password. Single use.
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model EmailToken {
  id        String         @id
  userId    String
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
  @@map("email_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Compliance
// ─────────────────────────────────────────────────────────────────────────────

/// Low/Medium/High per the Customer Risk Scoring procedure (AML/CFT
/// Procedures, P-03). The thresholds behind this are a starting
/// configuration, not a calibrated model — see `HIGH_RISK_KYC_COUNTRIES` in
/// @flt/core/services/kyc, which the same procedure document flags as
/// requiring calibration against real customer data and a proper risk
/// assessment before being relied on.
enum KycRiskTier {
  LOW
  MEDIUM
  HIGH
}

model KycProfile {
  id               String    @id
  userId           String    @unique
  status           KycStatus @default(NOT_STARTED)
  /// Which adapter owns this verification. Phase 1: "manual".
  provider         String
  /// The provider's own reference, when it issues one.
  providerRef      String?
  legalFirstName   String?
  legalLastName    String?
  dateOfBirth      DateTime?
  countryCode      String?

  /// The rest of P-01's required-information list beyond identity: where the
  /// customer lives, what they do, why they're opening the account, and how
  /// much they expect to move through it. None of this is optional at
  /// submission — Phase 1 has no vendor to fall back on to infer it later.
  residenceAddress       String?
  occupation             String?
  accountPurpose         String?
  expectedMonthlyVolume  String?

  /// Self-attestation per P-05. A "yes" does not reject the account — it
  /// forces the Enhanced Due Diligence track (mandatory EDD + MLRO-equivalent
  /// approval before activation) rather than an automatic decline.
  isPoliticallyExposed Boolean @default(false)
  pepDetails           String?

  /// Computed at submission per P-03. HIGH forces `sourceOfFundsEvidence` to
  /// be present (P-06) and is surfaced to the reviewer — it does not by
  /// itself block anything; only an unresolved decision does.
  riskTier               KycRiskTier @default(LOW)
  eddRequired             Boolean     @default(false)
  sourceOfFundsEvidence  String?
  /// Layered compliance: which regimes apply, from nationality + residence. See services/kyc-jurisdiction.ts.
  jurisdictions    String[]
  nationalityCode  String?
  phone            String?
  /// Identity document. The number is stored only as a hash + last four, never in the clear.
  idType           String?
  idCountry        String?
  idNumberHash     String?
  idNumberLast4    String?
  screeningStatus  String?
  screeningReason  String?

  submittedAt      DateTime?
  decidedAt        DateTime?
  /// The admin who decided, when the decision was manual.
  decidedByAdminId String?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy AdminUser?    @relation(fields: [decidedByAdminId], references: [id], onDelete: SetNull)
  documents KycDocument[]

  @@index([status])
  @@index([riskTier])
  @@map("kyc_profiles")
}

/// Metadata only. Document contents are never stored by this system — a real
/// provider holds them, and Phase 1's manual flow records only that a document
/// was presented.
model KycDocument {
  id           String   @id
  kycProfileId String
  documentType String
  /// Provider-side handle. Not a file path, not a URL we can dereference.
  /// Content hash, so the same document re-uploaded is recognisable.
  sha256      String?
  mimeType    String?
  sizeBytes   Int?
  /// The storage key (a filename under KYC_DOCUMENT_DIR). Cleared when purged.
  storageKey  String?
  /// When the retention job may delete the stored blob (submission + N years).
  retentionUntil DateTime?
  /// Set when the blob has been deleted; the metadata row is kept for audit.
  purgedAt    DateTime?
  externalRef  String?
  uploadedAt   DateTime @default(now())

  profile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Cascade)

  @@index([kycProfileId])
  @@map("kyc_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallets
//
// A connected wallet is not a linked wallet. Linking requires an EIP-4361
// signature over a server-issued nonce, so a user cannot claim an address they
// do not control.
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id          String    @id
  userId      String
  /// EIP-55 checksummed. Stored checksummed, compared lowercased.
  address     String
  chainId     Int
  label       String?
  isPreferred Boolean   @default(false)
  /// Which connector was used to link it: "injected", "walletConnect", ...
  connector   String?

  /// The provider's own identifier for a wallet it manages, where one exists.
  ///
  /// Null for a wallet the participant linked themselves — an address is all
  /// there is to know about a MetaMask account. Set for an embedded wallet,
  /// because signing through the provider is addressed by *its* id, not by the
  /// address: `createViemAccount` needs both, and an address alone cannot ask
  /// Privy to sign anything.
  providerWalletId String?
  /// Null until the ownership signature has been verified.
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain                 Chain                  @relation(fields: [chainId], references: [chainId])
  connections           WalletConnection[]
  quotes                Quote[]
  transactions          Transaction[]
  snapshots             PortfolioSnapshot[]
  perpOrders            PerpOrder[]
  perpPositionSnapshots PerpPositionSnapshot[]
  protectionPolicies    ProtectionPolicy[]

  @@unique([userId, address, chainId])
  @@index([address])
  @@index([userId])
  @@map("wallets")
}

/// Connect and disconnect events, for the activity trail. Not a session.
model WalletConnection {
  id             String    @id
  walletId       String
  connector      String
  ip             String?
  userAgent      String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_connections")
}

/// Single-use EIP-4361 nonces. Short-lived; the reaper deletes expired rows.
model WalletLinkNonce {
  id        String    @id
  userId    String
  nonce     String    @unique
  address   String?
  chainId   Int?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("wallet_link_nonces")
}

// ─────────────────────────────────────────────────────────────────────────────
// Registry
// ─────────────────────────────────────────────────────────────────────────────

model Chain {
  /// The EVM chain id is the natural key. Base is 8453.
  chainId        Int      @id
  name           String
  shortName      String
  nativeSymbol   String
  nativeDecimals Int      @default(18)
  explorerUrl    String
  isEnabled      Boolean  @default(true)
  disabledReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tokens  Token[]
  wallets Wallet[]
  custodyDeposits CustodyDeposit[]
  withdrawals Withdrawal[]

  @@map("chains")
}

model Token {
  id               String                @id
  chainId          Int
  /// EIP-55 checksummed contract address. Displayed in full in the interface —
  /// the user must always be able to see what they are actually buying.
  address          String
  symbol           String
  name             String
  decimals         Int
  logoUrl          String?
  verificationTier TokenVerificationTier @default(UNVERIFIED)
  /// Reference id for the market data provider, when it uses its own keys.
  marketDataRef    String?
  isEnabled        Boolean               @default(true)
  disabledReason   String?
  /// True for the chain's wrapped native asset, which the router treats
  /// specially.
  isNativeWrapper  Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  chain      Chain              @relation(fields: [chainId], references: [chainId], onDelete: Cascade)
  marketData MarketDataCache?
  candles    PriceCandleCache[]

  @@unique([chainId, address])
  @@index([chainId, isEnabled])
  @@index([symbol])
  @@map("tokens")
}

/// Registered routing venues. Rows here gate the adapters at runtime, so an
/// operator can disable a provider without a deployment.
model DexProvider {
  id                String       @id
  slug              String       @unique
  name              String
  kind              ProviderKind @default(DEX)
  isEnabled         Boolean      @default(true)
  disabledReason    String?
  /// Chain ids this provider is permitted to route on.
  supportedChainIds Int[]
  /// Non-secret adapter configuration. Credentials live in the environment.
  config            Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  quotes Quote[]

  @@map("dex_providers")
}

model MarketDataCache {
  id           String   @id
  tokenId      String   @unique
  priceUsd     Decimal? @db.Decimal(38, 18)
  change24hPct Decimal? @db.Decimal(12, 6)
  volume24hUsd Decimal? @db.Decimal(38, 2)
  liquidityUsd Decimal? @db.Decimal(38, 2)
  marketCapUsd Decimal? @db.Decimal(38, 2)
  source       String
  fetchedAt    DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
  @@map("market_data_cache")
}

/// Cached OHLCV candles for one token at one interval.
///
/// The chart provider's free tier is rate limited for the whole deployment
/// rather than per user, so a page render must never reach it directly: two
/// people opening the same chart would otherwise spend two of a shared budget
/// on identical data. Candles are keyed by token and interval because that is
/// what a viewer asks for, and the pool they came from is recorded alongside so
/// the interface can attribute the price to a venue.
model PriceCandleCache {
  id              String   @id
  tokenId         String
  interval        String
  /// The pool these candles were read from, and the venue that runs it.
  poolAddress     String
  poolDex         String
  poolQuoteSymbol String?
  /// Ascending by time, oldest first: [time, open, high, low, close, volume].
  candles         Json
  source          String
  fetchedAt       DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, interval])
  @@index([fetchedAt])
  @@map("price_candle_cache")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trading
// ─────────────────────────────────────────────────────────────────────────────

/// A firm, single-use quote bound to one user, one wallet and one taker
/// address, carrying the exact calldata the wallet is expected to sign.
///
/// Persisting txTo / txData / txValue is what makes tamper detection possible:
/// when the transaction lands, the monitor compares what was signed against
/// what we offered.
model Quote {
  id           String  @id
  userId       String
  walletId     String
  chainId      Int
  providerId   String?
  /// Adapter that produced this quote, recorded even if the provider row is
  /// later deleted.
  providerSlug String
  /// The provider's own request id, for support conversations.
  providerRef  String?

  sellTokenAddress String
  buyTokenAddress  String
  /// Base units, as decimal strings. Never floats.
  sellAmount       String
  buyAmount        String
  /// The on-chain floor. If the pool cannot deliver this, the swap reverts and
  /// the user keeps their input.
  minBuyAmount     String

  /// Estimated, not reported by the aggregator. Computed against a reference
  /// quote and labelled as an estimate in the interface.
  priceImpactBps   Int?
  slippageBps      Int
  /// Native-asset cost of execution, in base units.
  networkFeeNative String?
  networkFeeUsd    Decimal? @db.Decimal(24, 8)

  /// The FLT fee actually applied. `feeBpsRequested` records what the resolver
  /// intended before the aggregator's basis-point granularity was applied, so
  /// the rounding is visible rather than hidden.
  feeBps          Int     @default(0)
  feeBpsRequested Int?
  feeAmount       String?
  feeTokenAddress String?
  feeConfigId     String?

  /// Liquidity sources, for display and for the audit trail.
  routeJson Json?

  /// The unsigned transaction. The user's wallet signs this and nothing else.
  txTo            String
  txData          String
  txValue         String
  txGas           String?
  /// SHA-256 over (to, data, value). Compared against the mined transaction.
  calldataHash    String
  /// The contract the user must approve, when an allowance is required.
  /// AllowanceHolder — never the Settler contract.
  allowanceTarget String?
  allowanceNeeded String?

  takerAddress String
  status       QuoteStatus @default(ACTIVE)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime    @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  provider     DexProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  feeConfig    FeeConfig?    @relation(fields: [feeConfigId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("quotes")
}

model Transaction {
  id       String            @id
  userId   String
  walletId String
  quoteId  String?
  chainId  Int
  kind     TransactionKind
  /// Unique per chain: the same hash on two chains is two transactions.
  txHash   String
  status   TransactionStatus @default(SUBMITTED)

  blockNumber       BigInt?
  gasUsed           String?
  effectiveGasPrice String?
  /// What the chain actually did, parsed from logs. Distinct from the quoted
  /// amounts, which were only ever an expectation.
  amountInActual    String?
  amountOutActual   String?
  networkFeePaid    String?

  sellTokenAddress String?
  buyTokenAddress  String?

  failureReason  String?
  /// Set when the mined calldata does not match the quote we issued.
  tamperDetected Boolean @default(false)

  submittedAt DateTime  @default(now())
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  quote  Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  events TransactionEvent[]

  @@unique([chainId, txHash])
  @@index([userId, submittedAt])
  @@index([status])
  @@map("transactions")
}

/// Append-only lifecycle trail for one transaction. Rows are never updated.
model TransactionEvent {
  id            String            @id
  transactionId String
  status        TransactionStatus
  detail        String?
  blockNumber   BigInt?
  metadata      Json?
  occurredAt    DateTime          @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, occurredAt])
  @@map("transaction_events")
}

/// Point-in-time portfolio valuation, written by the worker. A convenience for
/// history — never authoritative. Live balances are always read from the chain.
model PortfolioSnapshot {
  id            String   @id
  walletId      String
  capturedAt    DateTime @default(now())
  holdingsJson  Json
  totalValueUsd Decimal? @db.Decimal(38, 2)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, capturedAt])
  @@map("portfolio_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform settings
//
// A small number of operational values an admin can change without a
// deploy — currently just the agentic-trading toggle and its DeepSeek key.
// Deliberately NOT where AGENT_KEY_ENCRYPTION_KEY lives: that key encrypts
// every participant's venue signing key, and storing it in the same
// database it protects would mean a single database breach compromises
// both the ciphertext and the key to read it. It stays an environment
// variable, set once on the server, by design — see
// @flt/core/services/platform-settings for the full reasoning.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformSetting {
  /// e.g. "agentic_trading_enabled", "deepseek_api_key".
  key   String @id
  /// AES-256-GCM ciphertext (via encryptSecret) when isSecret, plain text
  /// otherwise. Never the raw secret at rest either way.
  value String
  isSecret Boolean @default(false)

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fees
//
// Resolution is most-specific-first:
//   (chain, token) > (chain) > (account type) > global default
// No fee value is hard-coded anywhere in the application.
// ─────────────────────────────────────────────────────────────────────────────

model FeeConfig {
  id                   String  @id
  name                 String
  feeType              FeeType @default(PERCENTAGE)
  /// Basis points, for PERCENTAGE. 0x caps affiliate fees at 1000.
  bps                  Int?
  /// Base units of fixedFeeTokenAddress, for FIXED.
  fixedAmount          String?
  fixedFeeTokenAddress String?

  /// Narrowing predicates. Null means "applies to anything".
  chainId      Int?
  tokenAddress String?
  accountType  AccountType?

  /// Promotional windows.
  validFrom  DateTime?
  validUntil DateTime?

  /// Higher wins among equally specific rows.
  priority  Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([isEnabled, chainId])
  @@map("fee_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Administration
//
// Administrators are a separate table with separate sessions and separate
// cookies. An admin identity is not a consumer row with a flag set.
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id                 String    @id
  email              String    @unique
  passwordHash       String
  name               String
  role               AdminRole @default(VIEWER)
  isActive           Boolean   @default(true)
  /// MFA is mandatory for administrators, so this is not optional in practice.
  mfaSecretEncrypted String?
  mfaConfirmedAt     DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions     AdminSession[]
  actions      AdminAction[]
  kycDecisions KycProfile[]
  evcReviews   EvcPayment[]
  payouts      RemittanceOrder[]
  fiatReceived  FiatDeposit[] @relation("FiatDepositReceived")
  fiatSent      FiatDeposit[] @relation("FiatDepositSent")
  fiatDelivered FiatDeposit[] @relation("FiatDepositDelivered")

  @@map("admin_users")
}

model AdminSession {
  id             String    @id
  adminUserId    String
  tokenHash      String    @unique
  ip             String?
  userAgent      String?
  mfaSatisfiedAt DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Every sensitive administrative action. Immutable: inserted, never updated,
/// never deleted.
model AdminAction {
  id          String   @id
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  /// Operators must say why. Enforced at the API layer for state changes.
  reason      String?
  ip          String?
  userAgent   String?
  requestId   String?
  occurredAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("admin_actions")
}

/// System-wide audit trail covering users, providers and background jobs.
/// AdminAction is the operator-facing subset, kept separate so the question
/// "what did a human change?" is one query rather than a filter.
model AuditLog {
  id           String    @id
  actorType    ActorType @default(SYSTEM)
  actorUserId  String?
  actorAdminId String?
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  requestId    String?
  occurredAt   DateTime  @default(now())

  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Infrastructure
// ─────────────────────────────────────────────────────────────────────────────

model IdempotencyRecord {
  id             String            @id
  key            String
  endpoint       String
  userId         String?
  /// SHA-256 of the request body. Same key with a different body is a client
  /// bug, and replaying an unrelated response would be worse than failing.
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  @@unique([endpoint, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// Token buckets for rate limiting. Postgres rather than Redis: this system
/// already depends on Postgres, and the interface is narrow enough that moving
/// to Redis later is a one-file change.
model RateLimitBucket {
  id        String   @id
  key       String   @unique
  tokens    Decimal  @db.Decimal(18, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@map("rate_limit_buckets")
}

/// The perpetual markets FLT offers, which is a subset of what a venue lists.
///
/// A venue listing a market is not a decision to offer it, exactly as a token
/// existing on-chain is not a decision to list it. Hyperliquid carries over two
/// hundred markets including delisted ones; rows here are the ones an operator
/// has deliberately enabled, with an FLT leverage cap that can sit below the
/// venue's own.
model PerpMarket {
  id           String @id
  /// Adapter that owns this market, e.g. "hyperliquid".
  venueSlug    String
  symbol       String
  name         String
  /// The venue's own identifier. Never derived from list position — see the
  /// note on PerpMarket.venueAssetId in core.
  venueAssetId Int

  /// The venue's ceiling.
  venueMaxLeverage Int
  /// FLT's ceiling, which must be at or below the venue's. This is the number
  /// the interface enforces.
  maxLeverage      Int
  sizeDecimals     Int
  minSize          String

  isEnabled  Boolean        @default(false)
  /// What the contract tracks. A perp is a synthetic, so the underlying need
  /// not be crypto: venues list equity, index, FX and commodity perps that
  /// settle in stablecoins. They behave differently in ways a trader has to
  /// see — an equity mimic gaps over a weekend the crypto book trades straight
  /// through — so the class is carried rather than guessed from a symbol.
  assetClass PerpAssetClass @default(CRYPTO)

  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders             PerpOrder[]
  positions          PerpPositionSnapshot[]
  protectionPolicies ProtectionPolicy[]

  @@unique([venueSlug, symbol])
  @@index([venueSlug, isEnabled])
  @@map("perp_markets")
}

/// What FLT specified, before the venue was ever contacted.
///
/// The spot path proves a swap was not tampered with by hashing the calldata
/// and comparing it against the transaction that landed on-chain. There is no
/// calldata here — an order is a signed message posted to a venue this system
/// does not index — so the equivalent guarantee is reconstructed after the
/// fact: every economically meaningful field is persisted before the client is
/// handed anything, and the worker reconciles it against the fill the venue
/// reports. Divergence is an audit event, not a silent correction.
model PerpOrder {
  id        String          @id
  userId    String
  walletId  String
  marketId  String
  venueSlug String
  kind      PerpOrderKind   @default(OPEN)
  status    PerpOrderStatus @default(PREPARED)

  orderType    PerpOrderType @default(MARKET)
  /// The mark price at which a trigger order becomes live. Null for MARKET and
  /// LIMIT, which have nothing to wait for.
  triggerPrice String?

  /// A bracket's two protective legs, recorded on the entry that created them.
  /// Both are reduce-only and cancel each other when one fills.
  takeProfitPrice String?
  stopLossPrice   String?
  /// Groups an entry with the protective legs submitted alongside it, so the
  /// three can be reconciled as one intent rather than three unrelated orders.
  bracketGroupId  String?
  /// The venue's ids for the protective legs, so they can be replaced or
  /// cancelled later.
  ///
  /// Held on the entry rather than as their own PerpOrder rows on purpose:
  /// position attribution reads the *latest* order per market and treats CLOSE
  /// as flat, so a resting reduce-only leg recorded as its own CLOSE row would
  /// make an open position look closed to both the close path and the runner.
  takeProfitVenueOrderId String?
  stopLossVenueOrderId   String?
  /// When protective legs were last attached or changed on this position.
  bracketUpdatedAt DateTime?

  side          PerpSide
  /// Contracts, as a decimal string. Perp venues quote sizes and prices at a
  /// human scale rather than in token base units.
  size          String
  leverage      Int
  marginMode    PerpMarginMode @default(ISOLATED)
  /// The bound actually sent to the venue. A market order goes out as an
  /// immediate-or-cancel limit, never unbounded.
  limitPrice    String
  isMarketOrder Boolean        @default(true)
  slippageBps   Int
  reduceOnly    Boolean        @default(false)

  /// Reference price at preparation, for reconciling the fill against what the
  /// user was shown.
  referencePrice            String?
  /// What the interface displayed as the estimated liquidation price. Recorded
  /// because it is the number the user decided on.
  estimatedLiquidationPrice String?
  marginRequired            String?

  /// Builder code applied, in basis points, and where it was sent.
  feeBps       Int     @default(0)
  feeRecipient String?
  feeConfigId  String?

  /// The venue's identifier for the order, once the client reports it.
  venueOrderId     String?
  /// What actually filled, written by the worker from the venue's own record.
  filledSize       String?
  averageFillPrice String?
  /// Set when reconciliation found the fill inconsistent with what was
  /// prepared. Never overwritten silently.
  discrepancy      String?

  rejectionReason String?

  preparedAt  DateTime  @default(now())
  submittedAt DateTime?
  settledAt   DateTime?
  updatedAt   DateTime  @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  market PerpMarket @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@index([userId, preparedAt])
  @@index([status, preparedAt])
  @@index([venueSlug, venueOrderId])
  @@map("perp_orders")
}

/// FLT's automated market-making book — its own capital, not a participant's.
///
/// See docs/adr/0007-automated-market-making.md. One row per market the book
/// quotes. The kill switch is a column here rather than a deploy: an automated
/// system that trades real money needs an off that works without shipping code,
/// and a persisted flag survives the process that set it.
model MarketMakerConfig {
  id String @id

  /// The venue the book runs on, e.g. "hyperliquid".
  venueSlug String
  /// The single market the book quotes, e.g. "BTC".
  symbol    String

  /// Whether the runner quotes at all.
  isEnabled Boolean @default(false)
  /// Set by the kill switch. When true the runner cancels and stops quoting.
  halted       Boolean   @default(false)
  haltedReason String?
  haltedAt     DateTime?

  /// Half the base spread, in basis points.
  halfSpreadBps   Int
  /// How many levels each side.
  levels          Int    @default(3)
  /// Size per level, in contracts.
  levelSize       String
  /// Extra spread added per level, in basis points.
  levelStepBps    Int    @default(2)
  /// The most the book will hold, in contracts (sign enforced in code).
  maxInventory    String
  /// The most the book may lose in a day, in USD. Breaching it trips the halt.
  maxDailyLossUsd String
  /// Requote cadence, in milliseconds.
  requoteMs       Int    @default(5000)

  /// Bookkeeping for the runner and the profit distribution.
  lastRunAt         DateTime?
  lastDistributedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fills MakerFill[]

  @@unique([venueSlug, symbol])
  @@map("market_maker_configs")
}

/// One executed trade on the book, from the venue's own record.
///
/// Deliberately fills only. A resting order is read live from the venue
/// (`getOpenOrders`), and persisting every quote at a multi-second requote
/// cadence would make an order table a log of cancellations. The fill is the
/// economic event — it moves inventory and carries the venue's realized PnL —
/// so it is the thing worth keeping, deduped on the venue's trade id.
model MakerFill {
  id       String @id
  configId String

  venueSlug String
  symbol    String

  /// The venue's order id and the client order id the quote carried, when known.
  venueOid Int?
  cloid    String?
  /// The venue's trade id — the dedup key that makes ingestion idempotent.
  venueTid String
  /// The venue's settlement hash, when it reports one.
  venueHash String?

  isBuy  Boolean
  price  String
  size   String
  /// The venue fee, in USD.
  feeUsd String
  /// Realized PnL the venue books on this fill, in USD. Zero on an opening add.
  closedPnlUsd String @default("0")

  filledAt DateTime

  createdAt DateTime @default(now())

  config MarketMakerConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([venueSlug, venueTid])
  @@index([configId, filledAt])
  @@map("maker_fills")
}

/// A cached copy of a position the venue holds, refreshed by the worker.
///
/// The venue is the source of truth and this is explicitly a snapshot, not a
/// ledger. It exists so a position list renders without blocking on the venue,
/// and so liquidation proximity can be monitored between page loads. Anything
/// shown from here carries the time it was captured, because a stale
/// liquidation price is worse than no liquidation price.
model PerpPositionSnapshot {
  id        String @id
  userId    String
  walletId  String
  marketId  String
  venueSlug String

  side       PerpSide
  size       String
  entryPrice String
  margin     String
  marginMode PerpMarginMode @default(ISOLATED)
  leverage   Int

  /// The venue's own liquidation price. Authoritative; never replaced with a
  /// local estimate.
  liquidationPrice String?
  markPrice        String?
  unrealizedPnl    String?
  fundingPaid      String?

  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  market PerpMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([walletId, marketId])
  @@index([userId])
  @@index([capturedAt])
  @@map("perp_position_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Position protection
//
// A takaful-shaped design: participants contribute to a shared protection
// mechanism and an operator fee is kept strictly separate from participant
// funds. The mathematics lives in @flt/core/protection; these tables record
// what was calculated, when, and from which inputs.
//
// **No money moves through these tables.** FLT holds no participant funds and
// cannot act on a position — the only key that can close one lives in the
// user's browser. A contribution recorded here is a figure the participant
// declared, not a balance FLT custodies, and every reduction is advice. The
// ledger is built now so that when a pool does exist it is not retrofitted
// onto records that never separated the two kinds of money.
// ─────────────────────────────────────────────────────────────────────────────

enum ProtectionPolicyKind {
  BASE_DAY
  BASE_SMOOTH
  OMNI
}

/// §13's states. WARNING and POSITION_REDUCTION are reversible: a position that
/// recovers returns to ACTIVE rather than being stranded in a state it can
/// never leave. LIQUIDATED is the venue's outcome, not ours.
enum ProtectionState {
  CREATED
  ACTIVE
  WARNING
  PROTECTION_ACTIVE
  REBALANCE_REQUIRED
  POSITION_REDUCTION
  LIQUIDATED
  EXPIRED
  CANCELLED
}

/// What the entry recorded is, and whose money it would be.
///
/// The §19 requirement this enum exists to enforce: participant contribution
/// and operator revenue are never summed into one balance. A query that wants
/// "the pool" filters to the participant kinds; a query that wants revenue
/// filters to OPERATOR_FEE. Neither can accidentally include the other.
enum ProtectionLedgerKind {
  /// Participant capital committed against a policy.
  CONTRIBUTION
  /// Participant capital returned when a rebase lowered the requirement.
  RELEASE
  /// Contribution consumed by the protection actually being used.
  UTILIZATION
  /// The operator's management fee. Never part of the pool.
  OPERATOR_FEE
  /// Venue execution cost attributed to a protection-driven reduction.
  EXECUTION_FEE
  /// Realised profit or loss on a reduction the policy recommended.
  REALIZED_PNL
}

/// One participant's policy over one position.
///
/// Base Day and Base Smooth are entry-anchored, so their reference price is
/// fixed at creation and never written again. Omni rebases, which is the only
/// reason this table needs a mutable reference price at all.
model ProtectionPolicy {
  id        String               @id
  userId    String
  walletId  String
  marketId  String
  venueSlug String
  kind      ProtectionPolicyKind
  state     ProtectionState      @default(CREATED)

  side PerpSide

  /// Entry price, fixed for the life of the policy. Never silently modified —
  /// §14 lists it first among the values that must not change.
  entryPrice      String
  /// What the boundary is currently anchored to. Equal to entryPrice for the
  /// Base policies, forever; rewritten at each rebase for Omni.
  referencePrice  String
  /// Protected notional in USD, at the last calculation.
  notional        String
  /// Notional at creation, which is what Base Smooth's N_target scales from.
  initialNotional String

  /// Terms. §14 forbids changing any of these silently, so they are written
  /// once at creation and a change is a new policy, not an update.
  percentile         String
  horizonDays        String
  smoothStartAt      String?
  volatilityModel    String
  volatilityInterval String
  volatilityWindow   Int

  /// The last calculation's outputs, for display without recomputation. Never
  /// authoritative — the calculation endpoint recomputes from live inputs.
  lastZScore               String?
  lastVolatility           String?
  lastStatisticalMove      String?
  lastBoundary             String?
  lastRequiredContribution String?

  /// What the participant has declared they hold against this policy. Not a
  /// balance FLT custodies. See the section comment above.
  declaredContribution String @default("0")

  /// ── Premium, when the policy is bought rather than merely calculated ────
  ///
  /// Two amounts, never one. The contribution is risk capital and goes to the
  /// pool; the fee is FLT's revenue and goes to FLT. They are settled by two
  /// separate transfers to two separate addresses precisely so that no later
  /// query can accidentally treat them as one balance.
  ///
  /// FLT never holds either. The participant signs both transfers from their
  /// own wallet; these columns record what was asked for and what was paid.
  premiumContribution String?
  premiumOperatorFee  String?
  premiumTotal        String?
  premiumTokenAddress String?
  premiumChainId      Int?
  poolAddress         String?
  operatorAddress     String?
  /// The transfers the participant made, once each is verified on-chain.
  poolTxHash          String?
  operatorTxHash      String?
  paidAt              DateTime?

  /// Where this policy's credit should go when it is repriced or ends.
  creditDestination CreditDestination @default(BALANCE)

  calculatedAt DateTime?
  /// Omni only: when the next rebase is due.
  nextRebaseAt DateTime?
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  market PerpMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  events ProtectionEvent[]
  ledger ProtectionLedgerEntry[]

  @@index([userId, state])
  @@index([walletId, marketId])
  @@index([state, nextRebaseAt])
  @@map("protection_policies")
}

/// The immutable record §13 requires, one row per transition.
///
/// Append-only and written inside the same transaction as the state change, so
/// a policy can never move without the reason being recorded. Deliberately not
/// routed through audit(), which runs outside any transaction, swallows its own
/// write errors, and would silently redact fields it recognises by name.
///
/// Every quantity is a decimal string. A float here would make the row
/// irreproducible, which defeats the only purpose it has.
model ProtectionEvent {
  id       String @id
  policyId String

  fromState ProtectionState
  toState   ProtectionState

  /// The fourteen fields §13 names, plus the z convention — without which the
  /// z-score cannot be checked against the percentile.
  underlyingPrice            String
  markPrice                  String?
  volatility                 String
  volatilityModel            String
  percentile                 String
  zScore                     String
  zConvention                String
  horizonDays                String
  boundary                   String
  requiredContribution       String
  currentContribution        String
  positionSize               String
  notional                   String
  /// What the engine advised. Never what it did — it cannot do anything.
  action                     String
  executionPrice             String?
  fee                        String?
  remainingProtectionBalance String?

  occurredAt DateTime @default(now())

  policy ProtectionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, occurredAt])
  @@map("protection_events")
}

/// §19's ledger. Participant funds and operator revenue are separate rows with
/// separate kinds and are never netted against each other.
model ProtectionLedgerEntry {
  id       String               @id
  policyId String
  kind     ProtectionLedgerKind

  /// Signed. Positive adds to the balance of that kind, negative removes.
  amount       String
  /// The running balance of this kind after the entry, so a statement can be
  /// read without replaying every prior row.
  balanceAfter String

  /// Why the entry exists, in the participant's terms.
  reason  String
  /// The event that caused it, when a state change did.
  eventId String?

  occurredAt DateTime @default(now())

  policy ProtectionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, kind, occurredAt])
  @@map("protection_ledger_entries")
}

/// Where credit from a repriced or ended policy goes.
enum CreditDestination {
  /// Held as a stablecoin balance the participant can withdraw.
  BALANCE
  /// Returned as margin against the position it was protecting.
  POSITION
}

/// Operator-controlled protection settings, as a single row.
///
/// These are the numbers an operator has to be able to change without a deploy
/// — the reserve address most of all, because it is where participant capital
/// lands. Kept in the database rather than in env for that reason, and every
/// change is written to the admin audit trail.
///
/// The environment still supplies the defaults and still refuses to boot
/// without a reserve address in production; this overrides, it does not
/// replace.
model ProtectionSetting {
  /// Always "singleton". A settings table with two rows has no meaning.
  id String @id @default("singleton")

  /// Where participants' contributions are sent. Never the fee address.
  reserveAddress  String?
  /// Where FLT's management fee is sent.
  operatorAddress String?
  /// FLT's cut, in basis points of the contribution, charged on top of it.
  operatorFeeBps  Int     @default(1000)

  /// Default routing for credit; participants may override per policy.
  creditDestination CreditDestination @default(BALANCE)
  /// Whether participants may choose, or the default is imposed.
  allowCreditChoice Boolean           @default(true)

  /// The stablecoin premiums are paid in, and the chain it lives on.
  /// A premium denominated in a volatile asset would change value between the
  /// quote and the transfer, so this is a stablecoin address rather than a
  /// choice offered per trade.
  premiumTokenAddress String?
  premiumChainId      Int?

  /// off | optional | required
  mode String @default("off")

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("protection_settings")
}

/// The three subscription tiers, plus the implicit free tier.
///
/// Named rather than numbered so a row cannot be reordered into meaning
/// something else, and so a log line saying PRO is readable a year later.
enum SubscriptionTier {
  /// Not a paid tier — what an account has when nothing is active. Carried in
  /// the enum so entitlement checks never have to special-case null.
  FREE
  BASIC
  PRO
  ELITE
}

enum SubscriptionStatus {
  /// Written when the plan is chosen; entitlements do NOT apply yet.
  PENDING_PAYMENT
  ACTIVE
  /// Ran to its paid-through date without renewal.
  EXPIRED
  /// Ended early by the participant or an operator.
  CANCELLED
}

/// Operator-controlled pricing and limits for one tier.
///
/// In the database rather than in code because price, limits and the fee
/// discount are commercial decisions that change without a deploy, and because
/// an operator changing them should leave an audit trail. The seed sets the
/// published ladder; nothing here is hardcoded anywhere else.
model SubscriptionPlan {
  /// The tier this configures. One row each.
  tier SubscriptionTier @id

  /// Shown to the participant, e.g. "FLT Pro".
  name        String
  /// One line under the name on the pricing page.
  tagline     String
  /// Monthly price in USD, as a decimal string — never a float.
  priceUsd    String
  /// Drawn as the default choice on the pricing page. Exactly one should be true.
  isFeatured  Boolean @default(false)
  isAvailable Boolean @default(true)

  /// Reduction on trading fees, in basis points OF THE FEE, not of notional.
  /// 1000 = the fee is 10% smaller. Never a discount on notional, which would
  /// be a different and much larger number.
  feeDiscountBps Int @default(0)

  /// Null means unlimited. Zero means the feature is off.
  watchlistLimit  Int?
  priceAlertLimit Int?
  /// How far back trade history is visible. Null is unlimited.
  historyDays     Int?

  /// Capability flags, kept as columns rather than a JSON blob so a query can
  /// answer "who has API access" without parsing every row.
  advancedOrderTools          Boolean @default(false)
  fullIndicators              Boolean @default(false)
  advancedRiskAnalytics       Boolean @default(false)
  advancedProtectionAnalytics Boolean @default(false)
  fundingAnalytics            Boolean @default(false)
  advancedPnl                 Boolean @default(false)
  fullPnl                     Boolean @default(false)
  apiAccess                   Boolean @default(false)
  priorityData                Boolean @default(false)
  prioritySupport             Boolean @default(false)

  /// Opening trades allowed per day. Null is unlimited.
  ///
  /// Counts openings only. Closing a position is never limited: a limit that
  /// can trap somebody in a leveraged position is not a pricing lever, it is a
  /// hazard, and no commercial reason justifies it.
  dailyTradeLimit Int?

  /// Whether this tier may trade perpetuals at all.
  perpsAccess Boolean @default(true)

  /// Whether this tier may enable the AI trading agent.
  ///
  /// Separate from `perpsAccess` deliberately: perpetuals access controls
  /// what a human may trade manually, and agentic trading is a different,
  /// higher-trust grant — FLT holds a signing key for it. A tier can permit

  /// The highest leverage this tier may use.
  ///
  /// Free accounts are capped at 2x: leverage past that is the point at which a
  /// position can be liquidated by an ordinary day's move, and gating it is
  /// both the commercial hook and a real risk boundary. Still bounded by
  /// PERP_MAX_LEVERAGE and by the venue, whichever is lower.
  maxLeverage Int @default(2)

  updatedAt   DateTime @updatedAt
  updatedById String?

  subscriptions Subscription[]

  @@map("subscription_plans")
}

/// One participant's subscription.
model Subscription {
  id     String @id
  userId String

  tier   SubscriptionTier
  status SubscriptionStatus @default(PENDING_PAYMENT)

  /// Entitlements apply only between these, and only while status is ACTIVE.
  /// There is no auto-renewal: FLT holds no key that could pull from a wallet,
  /// so a period is bought and then bought again.
  startsAt DateTime?
  endsAt   DateTime?

  /// What was actually charged, recorded rather than re-derived — a later price
  /// change must not rewrite what somebody paid.
  pricePaidUsd String?
  tokenAddress String?
  chainId      Int?
  /// The transfer, once verified on-chain. A browser claiming payment is not
  /// payment.
  txHash       String?
  paidAt       DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [tier], references: [tier])

  @@index([userId, status])
  @@index([status, endsAt])
  @@map("subscriptions")
}

enum EvcPaymentStatus {
  /// The participant says they have paid. Nothing has been verified.
  AWAITING_REVIEW
  /// An operator matched it against the merchant statement and granted the plan.
  CONFIRMED
  /// An operator could not find the payment, or it did not match.
  REJECTED
}

/// A claimed EVC Plus (mobile money) payment for a subscription.
///
/// ## Why this is a claim and not a payment
///
/// EVC Plus has no merchant API available to FLT, so nothing here can verify
/// that money moved. The participant dials the USSD string on their own phone,
/// then tells us they did. That is a *claim*, and this model is deliberately
/// named and staged so nobody downstream mistakes it for a settled payment:
/// the row is AWAITING_REVIEW, it grants nothing, and entitlements do not
/// change until an operator has looked at the merchant statement and confirmed.
///
/// The on-chain rail in `Subscription` is the opposite — it verifies against a
/// mined receipt and needs no human. These two rails are kept separate rather
/// than merged so that "verified by a receipt" and "vouched for by an operator"
/// are never the same field.
model EvcPayment {
  id     String @id
  userId String

  /// What they are buying. Applied via the ordinary operator grant path on
  /// confirmation, so an EVC purchase and a manual grant produce the same
  /// subscription rows and the same audit trail.
  tier SubscriptionTier
  /// Days granted on confirmation. Recorded here rather than re-derived, so a
  /// later change to the period length cannot alter a past purchase.
  days Int

  /// Priced in USD, as a decimal string — never a float.
  amountUsd String

  /// As the participant gave them. This is what an operator matches against
  /// the merchant statement, so it is captured verbatim and never normalised
  /// into something that no longer matches what the telco recorded.
  payerName  String
  payerPhone String

  /// The merchant number this was quoted against, snapshotted at creation.
  /// If an operator changes the merchant number later, an older claim must
  /// still say which number it was told to pay.
  merchantNumber String

  status EvcPaymentStatus @default(AWAITING_REVIEW)

  /// Set on confirmation. The subscription an operator's decision produced.
  subscriptionId String?
  reviewedAt     DateTime?
  reviewedById   String?
  /// Why it was rejected, or which statement line matched on confirmation.
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation(fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("evc_payments")
}

enum RemittanceStatus {
  /// Quoted and recorded. The participant has not sent the crypto yet.
  AWAITING_TRANSFER
  /// The inbound transfer is confirmed in a mined receipt. FLT now owes a payout.
  AWAITING_PAYOUT
  /// An operator has sent the fiat and recorded the EVC reference.
  PAID
  /// Refused before payout — screening, a mismatch, or a transfer that never arrived.
  REJECTED
  /// Withdrawn by the participant before sending anything.
  CANCELLED
}

/// One crypto-to-fiat remittance: stablecoin in, EVC Plus payout out.
///
/// ## This is money transmission, and the model says so
///
/// Everything else on this platform is non-custodial by construction. This is
/// not: between the inbound transfer confirming and the operator sending the
/// fiat, FLT holds the participant's money and owes them a payout. That window
/// is the entire risk of this feature, so it is a status of its own
/// (AWAITING_PAYOUT) rather than an implicit gap between two other states —
/// "what do we owe, and to whom" has to be answerable with one query.
///
/// ## The two legs are asymmetric on purpose
///
/// The inbound leg is verified against a mined receipt: token, sender,
/// recipient and amount all checked, and a browser claiming payment counts for
/// nothing. The outbound leg cannot be verified at all — EVC Plus exposes no
/// merchant API to FLT — so it is an operator action with a recorded reference.
/// Storing them as one "completed" flag would let an unverifiable step inherit
/// the credibility of a verified one.
///
/// ## Travel Rule fields are first-class columns
///
/// FATF R.16 requires originator and beneficiary information to travel with a
/// transfer. Both sides are stored as columns rather than derived at report
/// time: the participant's KYC name can change, the beneficiary is often not
/// the participant at all, and a report has to say who they were *then*.
model RemittanceOrder {
  id     String @id
  userId String

  status RemittanceStatus @default(AWAITING_TRANSFER)

  // ── Inbound: what the participant sends ─────────────────────────────────
  /// The stablecoin, and the chain it is sent on.
  tokenAddress String
  chainId      Int
  /// In the token's own base units — never a float.
  sendAmount    String
  /// The dollar value the quote was struck at.
  sendAmountUsd String

  /// The originator's wallet, snapshotted. Travel Rule: the account the funds
  /// came from, recorded at the time rather than looked up later, because a
  /// wallet can be unlinked from an account afterwards.
  originatorWallet String
  /// The participant's legal name as KYC held it when the order was placed.
  originatorName   String

  /// Verified against the receipt, not claimed by a browser.
  txHash     String?   @unique
  verifiedAt DateTime?

  // ── Outbound: what the beneficiary receives ─────────────────────────────
  beneficiaryName  String
  beneficiaryPhone String
  /// How the beneficiary is known to the sender. A remittance to a stranger is
  /// a different proposition from one to a family member, and an operator
  /// reviewing a payout is entitled to the sender's own answer.
  beneficiaryRelationship String
  /// Why the money is being sent. Required by the AML/CFT procedures for
  /// exactly this kind of transfer.
  purpose                 String

  /// Rate and fee snapshotted at quote time, so a later repricing cannot
  /// rewrite what somebody was promised.
  fxRate         String
  feeUsd         String
  payoutAmount   String
  payoutCurrency String

  // ── Settlement ──────────────────────────────────────────────────────────
  /// The EVC transaction reference an operator recorded when paying out.
  payoutReference String?
  paidAt          DateTime?
  paidByAdminId   String?
  /// Why it was refused, shown to the participant.
  reviewNote      String?

  /// Set when screening or an operator flags it for a closer look. Kept
  /// separate from `status` so a held order is still visibly awaiting payout
  /// rather than disappearing from what FLT owes.
  heldAt     DateTime?
  heldReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// The quote stops being honourable after this.
  expiresAt DateTime

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidBy   AdminUser? @relation(fields: [paidByAdminId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("remittance_orders")
}

/// A referral code somebody can post publicly.
///
/// One per account. A second code would let one person run several campaigns
/// and make attribution a question rather than a fact, and the program is
/// deliberately simple: one code, one level, no downstream.
model ReferralCode {
  id     String @id
  userId String @unique

  /// Short, unambiguous, and safe to say out loud. Stored uppercase; lookups
  /// normalise, so a code posted in lowercase still works.
  code String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation("ReferralCodeOwner", fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@map("referral_codes")
}

/// One person redeeming one code, once, ever.
///
/// `referredUserId` is unique across the whole table rather than per code: an
/// account can be referred once in its life. Without that, somebody could
/// redeem a second code after the first month expired and take the free tier
/// again indefinitely.
model Referral {
  id     String @id
  codeId String

  referrerUserId String
  referredUserId String @unique

  /// The free period granted to the person who redeemed. Null if the grant
  /// failed, which is recoverable — the referral still stands.
  grantedSubscriptionId String?

  redeemedAt DateTime @default(now())

  code     ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrer User         @relation("ReferralsMade", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User         @relation("ReferredBy", fields: [referredUserId], references: [id], onDelete: Cascade)

  earnings ReferralEarning[]

  @@index([referrerUserId])
  @@map("referrals")
}

enum ReferralEarningKind {
  /// A share of a subscription payment.
  SUBSCRIPTION
  /// A share of a trading fee.
  TRADING_FEE
}

enum ReferralEarningStatus {
  /// Recorded and owed. FLT holds no balance, so nothing is "available" until
  /// somebody pays it out.
  ACCRUED
  PAID
  /// Reversed — a refund, a chargeback, a fee that never landed.
  VOIDED
}

/// One share of one piece of revenue.
///
/// Recorded per event rather than as a running total, so every cent owed can be
/// traced to the trade or payment that produced it. A balance that cannot be
/// itemised is not a balance, it is an assertion.
model ReferralEarning {
  id         String @id
  referralId String

  referrerUserId String
  kind           ReferralEarningKind
  status         ReferralEarningStatus @default(ACCRUED)

  /// The revenue this is a share of, and the share taken, so the arithmetic is
  /// reproducible from the row alone.
  grossAmount  String
  shareBps     Int
  amount       String
  /// What the amounts are denominated in. A trading fee is taken in whatever
  /// token was traded, so this is not always the same currency.
  tokenAddress String?
  chainId      Int?
  /// Set for a subscription share, which is always in the payment token.
  currency     String?

  /// What produced it. Exactly one is set.
  subscriptionId String?
  quoteId        String?

  paidAt     DateTime?
  paidTxHash String?
  voidReason String?

  createdAt DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrer User     @relation("ReferralEarnings", fields: [referrerUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, status])
  @@index([status])
  @@map("referral_earnings")
}

enum PassiveCashEntryKind {
  CONTRIBUTION
  WITHDRAWAL
  /// The participant's share of trading profit.
  PROFIT_SHARE
  /// A loss against contributed capital.
  LOSS
}

/// A participant's opt-in to having idle cash used in market-making.
///
/// ## What this is, stated plainly
///
/// Money the participant hands over for FLT to trade with, in exchange for half
/// the profit. That is custody and it is a managed investment — a different
/// relationship from everything else on this platform, where FLT never holds
/// anything. It is modelled separately for that reason: nothing here shares a
/// table with a trading balance, and no code path treats it as the same kind of
/// thing.
///
/// ## Losses
///
/// The upside is split. The downside is not: a participant bears losses against
/// their own contributed capital, because the alternative is FLT guaranteeing a
/// principal it has no mechanism to guarantee. `lossShareBps` records the term
/// that was actually agreed rather than leaving it to be assumed.
model PassiveCashAccount {
  id     String @id
  userId String @unique

  /// Off until the participant switches it on, and switchable off at any time.
  isEnabled Boolean @default(false)

  /// Contributed capital, in the account's denomination.
  balance        String @default("0")
  /// Cumulative profit paid to the participant, for display.
  lifetimeEarned String @default("0")
  /// Cumulative losses borne, for display. Never netted against earnings —
  /// a single figure would hide which is which.
  lifetimeLost   String @default("0")

  tokenAddress String?
  chainId      Int?

  /// The participant's share of profit. 5000 = half.
  profitShareBps Int @default(5000)
  /// The participant's share of losses. 10000 = they bear all of it.
  lossShareBps   Int @default(10000)

  /// The disclosure that was actually shown, and when it was accepted.
  /// A term nobody can prove was displayed is a term that was not agreed.
  disclosureVersion    String?
  disclosureAcceptedAt DateTime?

  enabledAt  DateTime?
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PassiveCashEntry[]

  @@map("passive_cash_accounts")
}

/// One movement. The balance is the sum of these and is never written alone.
model PassiveCashEntry {
  id        String @id
  accountId String

  kind         PassiveCashEntryKind
  /// Always positive; `kind` carries the direction.
  amount       String
  /// The balance after this entry, so a statement reconciles line by line.
  balanceAfter String

  /// For a profit share: the gross result this is a share of, and the share
  /// taken, so the arithmetic is reproducible from the row.
  grossAmount String?
  shareBps    Int?

  reason String?
  txHash String?

  createdAt DateTime @default(now())

  account PassiveCashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("passive_cash_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Custody ledger
//
// FLT holds client assets at a qualified sub-custodian and owes each client a
// balance. That liability is what this ledger records, and it is the part that
// cannot be got wrong: Mt. Gox was drained for years because nobody compared an
// internal ledger to the chain, and FTX permitted a balance that could never be
// covered. Both are ledger failures, not cryptography failures.
//
// Three properties are enforced by the database rather than by application
// code, because a rule that lives only in a service is a rule until somebody
// writes a second service:
//
//   1. Every transfer's entries sum to exactly zero (a constraint trigger).
//   2. An account marked non-negative can never go below zero (a CHECK).
//   3. A transfer's (kind, reference) pair is unique, so a retried deposit
//      credits once.
//
// Amounts are NUMERIC(38,18), not strings. Money is stored as decimal strings
// elsewhere in this schema, and that is right where the database only has to
// hand the value back. Here it has to SUM balances and enforce a sign, so the
// type has to be one Postgres understands.
// ─────────────────────────────────────────────────────────────────────────────

enum LedgerAccountKind {
  /// A client's spendable balance. A liability: FLT owes it.
  USER_AVAILABLE
  /// A client's balance reserved against an open order or a pending
  /// withdrawal. Still owed to them, but not spendable twice.
  USER_LOCKED
  /// What the sub-custodian holds for clients, in aggregate. An asset.
  /// Segregated by construction: operational funds never touch this account.
  CLIENT_OMNIBUS
  /// FLT's own revenue. Deliberately a separate account from CLIENT_OMNIBUS —
  /// commingling those two is the single most common way a custodian fails.
  FEE_REVENUE
  /// Fiat received and not yet converted, or vice versa.
  FIAT_GATEWAY
  /// Perpetual margin held at the venue — the pooled Hyperliquid USDC. An
  /// asset, like CLIENT_OMNIBUS, and kept separate from it: spot collateral
  /// and venue margin live in different places and fail separately. See
  /// docs/adr/0005-perps-custody.md.
  VENUE_MARGIN
  /// FLT's own capital, held alongside client funds. Liability-side (stored
  /// <= 0). Absorbs the residual between what the platform holds and what it
  /// owes, so a client balance is never socialized to cover it. See
  /// docs/adr/0006-perps-accounting.md (P8).
  PLATFORM_EQUITY
}

enum LedgerTransferKind {
  DEPOSIT
  WITHDRAWAL
  TRADE_SETTLEMENT
  FEE
  LOCK
  UNLOCK
  /// An operator correcting the ledger. Always attributed, always reasoned.
  ADJUSTMENT
}

model LedgerAccount {
  id     String            @id
  kind   LedgerAccountKind
  /// Null for platform accounts (omnibus, revenue, gateway).
  userId String?

  /// The unit this account is denominated in — "USDC", "USD". One account per
  /// asset: a single account holding mixed assets cannot be reconciled.
  asset String

  /// Maintained in the same transaction as the entries that move it, and
  /// re-derived from those entries by the reconciliation job. The column is an
  /// optimisation; the entries are the truth.
  balance Decimal @default(0) @db.Decimal(38, 18)

  /// Escape hatch from the sign constraint. False everywhere today.
  ///
  /// The constraint is per account type, not blanket: asset accounts hold a
  /// natural debit balance (>= 0) and liability accounts a natural credit
  /// balance (<= 0). See the 20260910090000 migration for why a single
  /// "balance >= 0" rule made a deposit impossible to record.
  allowsNegative Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@unique([kind, userId, asset])
  @@index([userId])
  @@map("ledger_accounts")
}

model LedgerTransfer {
  id   String             @id
  kind LedgerTransferKind

  /// The external fact this transfer records — a custodian transaction id, an
  /// EVC payment id, a withdrawal id. Unique per kind, so replaying a webhook
  /// or retrying a job credits exactly once.
  reference String?

  /// Why this movement happened, in words. Read by whoever investigates a
  /// discrepancy months later.
  memo String

  createdByAdminId String?
  createdAt        DateTime @default(now())

  entries LedgerEntry[]

  @@unique([kind, reference])
  @@index([createdAt])
  @@map("ledger_transfers")
}

model LedgerEntry {
  id         String @id
  transferId String
  accountId  String

  /// Signed. Positive increases the account, negative decreases it, and every
  /// transfer's entries sum to zero — enforced by a deferred constraint
  /// trigger, not by whoever wrote the calling service.
  amount Decimal @db.Decimal(38, 18)

  createdAt DateTime @default(now())

  transfer LedgerTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  account  LedgerAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transferId])
  @@map("ledger_entries")
}

/// A participant's standing permission for FLT to direct their FLT-provisioned
/// wallet.
///
/// ## Why this is a record and not a boolean
///
/// FLT does not hold the key — Privy does — but instructing Privy to sign on
/// somebody's behalf is still a real power, and the difference between that and
/// custody is not something a participant should have to infer. So the
/// permission is granted explicitly, versioned like the other disclosures on
/// this platform, and revocable.
///
/// `version` is what makes a change of terms meaningful: a delegation accepted
/// under wording that has since changed does not carry forward, the same
/// discipline `PassiveCashAccount` and the venue-key flow use. Somebody who
/// agreed that FLT could place the trades they choose has not thereby agreed to
/// anything wider.
///
/// One row per participant rather than per wallet: the EVM key is shared across
/// every EVM chain, so consent per wallet row would ask the same question three
/// times and let the answers disagree.
model WalletDelegation {
  id     String @id
  userId String @unique

  /// The wording accepted, so a later change of terms invalidates it.
  version    String
  acceptedAt DateTime @default(now())

  /// Set when the participant withdraws it. The row is kept: "this permission
  /// existed between these dates" is the question an investigation asks.
  revokedAt DateTime?

  /// Captured at acceptance, as with every other consent on this platform.
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_delegations")
}

enum FiatDepositMethod {
  ACH
  WIRE
  EVC
  CASH
  /// Sent to FLT's PayPal address and matched by the payer's PayPal email.
  PAYPAL
}

enum FiatDepositStatus {
  /// The participant says money is coming. Nothing has been received.
  AWAITING_FUNDS
  /// Cash is in FLT's account, matched to this request. FLT now owes them,
  /// and the ledger says so.
  FUNDS_RECEIVED
  /// Stablecoin has been sent to their wallet and the transaction is in
  /// flight. Still owed: a broadcast transaction is not a delivered one, and
  /// collapsing this into DELIVERED would discharge a debt on the strength of
  /// an operator pressing a button.
  SENT
  /// The transfer is confirmed in a mined receipt. The liability is
  /// discharged and the funds are theirs to trade.
  DELIVERED
  /// Funds never arrived, or the deposit was refused.
  REJECTED
}

/// One fiat deposit, from cash arriving to crypto landing in the participant's
/// own wallet.
///
/// ## Two steps, because there are two facts
///
/// "The money arrived" and "the crypto was delivered" are separate events with
/// a gap between them, and during that gap FLT is holding somebody's money
/// without having given them anything. That gap is a real liability and the
/// ledger records it — which is the whole reason this is two statuses and not
/// a boolean. A single "done" flag would make the exposure invisible exactly
/// while it exists.
///
/// ## Where the crypto goes
///
/// To the participant's own FLT wallet, whose key is held by Privy and not by
/// FLT. So once delivered, FLT is not custodian of it and owes nothing further
/// — the balance on screen is then their on-chain balance, not a number in
/// this table. Attribution needs no new mechanism: the wallet already carries
/// this user's id, both here and at Privy.
///
/// ## Neither leg is automatic, and the model does not pretend otherwise
///
/// A person watches a bank account, and a person sends the crypto. Both are
/// recorded with who did it and what reference they matched, because an
/// operator-confirmed movement with no reference is indistinguishable from a
/// mistake.
model FiatDeposit {
  id     String @id
  userId String

  method   FiatDepositMethod
  currency String            @default("USD")
  /// What the participant said they would send.
  amountFiat Decimal         @db.Decimal(38, 18)

  /// The name and number on the account the money is coming from.
  ///
  /// This is what an operator matches against a bank or EVC statement. The
  /// reference code is the primary key of that match, but people forget to
  /// include it, and a name and number are what make a line findable anyway.
  payerName  String?
  payerPhone String
  /// The PayPal address a PayPal deposit is coming from.
  payerEmail String?

  /// What actually arrived, set when an operator confirms it. Kept separate
  /// from `amountFiat` because they differ often enough to matter — bank fees,
  /// a wrong figure typed at the counter — and silently trusting the claimed
  /// amount would credit money that never came.
  amountReceived Decimal? @db.Decimal(38, 18)

  /// FLT's cut, and what the participant is owed after it.
  feeUsd Decimal? @db.Decimal(38, 18)
  netUsd Decimal? @db.Decimal(38, 18)

  /// The code the participant is told to put on their transfer, and whatever
  /// the operator matched it against on the statement.
  reference      String  @unique
  bankReference  String?

  status FiatDepositStatus @default(AWAITING_FUNDS)

  /// The address the crypto was sent to, snapshotted. A participant can
  /// provision a new wallet later, and a report has to say where it actually
  /// went.
  deliveryAddress String?
  deliveryChainId Int?
  deliveryTxHash  String?
  deliveredAt     DateTime?

  receivedAt      DateTime?
  receivedById    String?
  /// When the transfer was broadcast, as distinct from when it confirmed.
  sentAt          DateTime?
  sentById        String?
  deliveredById   String?
  /// Why it was refused, or which statement line matched.
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivedBy AdminUser? @relation("FiatDepositReceived", fields: [receivedById], references: [id])
  sentBy      AdminUser? @relation("FiatDepositSent", fields: [sentById], references: [id])
  deliveredBy AdminUser? @relation("FiatDepositDelivered", fields: [deliveredById], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("fiat_deposits")
}

enum CustodyDepositStatus {
  /// A stablecoin transfer to a participant's deposit address has been seen
  /// on-chain. Nothing has moved yet; the funds are still theirs, on-chain.
  DETECTED
  /// A sweep into the omnibus has been broadcast. Not yet confirmed, and
  /// therefore not yet credited — a broadcast is not a mined transfer.
  SWEEPING
  /// The sweep is confirmed in a mined receipt. Ready to credit.
  SWEPT
  /// The ledger has credited the participant's available balance. Terminal.
  CREDITED
  /// The sweep failed (reverted, or the address could not be swept). Nothing
  /// was credited; the funds remain where they are.
  FAILED
}

/// A crypto deposit into custody: stablecoin arriving at a participant's own
/// FLT deposit address, and being swept into the omnibus.
///
/// ## Why this is a record and not just a ledger entry
///
/// The credit must happen only once the sweep is confirmed in a mined receipt —
/// crediting on a broadcast would credit a transfer that could still revert,
/// which is the exact failure `fiat-deposits.ts` is shaped to avoid. So
/// detection, the sweep and the credit are three facts separated by time, and
/// each has to survive a worker restart in between. This row is where that
/// state lives, so the pipeline is safe to run over and over.
///
/// ## The detection identity
///
/// `(chainId, depositTxHash, logIndex)` is one inbound transfer, unique, so
/// re-scanning the same block credits the same deposit once rather than minting
/// a second. `depositAddress` is snapshotted because a participant can
/// provision a different address later, and a report has to say where the funds
/// actually landed.
model CustodyDeposit {
  id     String @id
  userId String

  asset    String
  chainId  Int
  decimals Int
  /// The exact amount, in base units, as the chain reported it. A string,
  /// because a uint256 fits no numeric type and the amount is the one number
  /// that must not lose precision.
  amountBaseUnits String

  /// The network (gas) fee charged against this deposit, in base units.
  ///
  /// The sweep is a transaction *from* the deposit address, which holds only
  /// stablecoin — so the omnibus fronts the gas, and the fee is recovered from
  /// the deposit (capped at 1%). Recorded so the credited amount reconciles
  /// against the amount the chain actually delivered.
  gasCostBaseUnits String @default("0")

  /// How many times the sweep has been attempted, so a transient failure heals
  /// itself and a permanent one stops instead of looping forever.
  attempts Int @default(0)

  depositAddress String
  depositTxHash  String
  logIndex       Int

  /// Set when the sweep is broadcast, and set again (`sweptAt`) when it
  /// confirms.
  sweepTxHash String?
  sweptAt     DateTime?

  /// The ledger reference the credit was posted under, so the balance a
  /// participant sees can be traced back to the transfer that created it.
  ledgerReference String?

  status        CustodyDepositStatus @default(DETECTED)
  failureReason String?

  creditedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain Chain @relation(fields: [chainId], references: [chainId])

  @@unique([chainId, depositTxHash, logIndex])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("custody_deposits")
}

enum WithdrawalStatus {
  /// Requested and the funds are locked, but nothing has been broadcast yet.
  PENDING
  /// A broadcast has been attempted and its outcome is not yet known.
  ///
  /// Set before the send, so a send whose response is lost cannot look like a
  /// send that never happened. A row here is never re-broadcast blindly: the
  /// worker first looks on-chain for a matching transfer, and only returns it to
  /// PENDING when it can see that nothing left.
  BROADCASTING
  /// A transfer from the omnibus has been broadcast. Not yet confirmed.
  SENT
  /// Confirmed in a mined receipt. The ledger has been debited. Terminal.
  COMPLETED
  /// The broadcast failed or reverted. The lock has been released. Terminal.
  FAILED
}

/// A withdrawal: a participant asking to take funds out of custody.
///
/// ## Why funds are locked first
///
/// Between the request and the on-chain transfer the participant still holds the
/// balance on the ledger. Left spendable, they could commit it to a trade and to
/// a withdrawal at once and only one would be honourable. So the request moves
/// the amount from available to locked, and this is the only thing that can
/// spend it.
///
/// ## The debit is on a mined receipt, never a broadcast
///
/// A broadcast can revert or be dropped. Debiting on the strength of having sent
/// it would book money as gone that never left — the discipline the deposit and
/// fiat rails keep, for the same reason.
model Withdrawal {
  id     String @id
  userId String

  asset    String
  chainId  Int
  decimals Int
  /// The amount, in base units, as the chain needs it.
  amountBaseUnits String

  destinationAddress String

  /// The omnibus transfer, once broadcast.
  txHash String?

  status        WithdrawalStatus @default(PENDING)
  failureReason String?

  /// How many times a broadcast has been attempted. A row that keeps returning
  /// to PENDING is a row an operator needs to look at.
  broadcastAttempts Int @default(0)
  /// When the most recent broadcast was attempted, so a BROADCASTING row that
  /// needs resolving can be aged.
  broadcastAt DateTime?

  sentAt      DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain Chain @relation(fields: [chainId], references: [chainId])

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("withdrawals")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trading algorithms
//
// FLT offers two automated offerings. **Algo trader** runs a deterministic,
// FLT-authored strategy; the participant allocates capital and the runner trades
// it. **AI trader** runs an LLM over a prompt. Both are frictionless — no entry
// cost — and carry a management fee of 2%/month of the participant's allocated
// capital, pro-rated daily and taken on exit. Every order either places is
// subject to the same leverage, entitlement, balance and insurance rules as a
// manual one — activation buys the automation, never a bypass of the checks.
// ─────────────────────────────────────────────────────────────────────────────

/// Lifecycle of a purchased algorithm.
enum AlgorithmStatus {
  /// Bought and running. The worker may place orders for it.
  ACTIVE
  /// Bought but paused by the participant. No new orders, position untouched.
  PAUSED
  /// The paid period ended. Nothing runs until it is bought again.
  EXPIRED
  /// Stopped by the participant or an operator. Terminal until re-purchased.
  CANCELLED
}

/// The built-in strategy a catalog entry runs.
///
/// Deliberately a closed set. A purchased algorithm is an FLT-authored,
/// reviewed strategy, not arbitrary participant code — the worker signs real
/// orders with a server-held key, so the strategies that can reach it are
/// enumerated here rather than described by the buyer.
enum AlgorithmStrategy {
  /// Long when the fast average is above the slow one, short when below.
  MA_CROSSOVER
  /// Fade a move away from its average, on the expectation it reverts.
  MEAN_REVERSION
  /// Follow the sign of a lookback return.
  MOMENTUM
}

/// Which offering a catalog row is.
enum AlgorithmKind {
  /// Deterministic: trades by a fixed, FLT-authored strategy. Open to every
  /// account.
  ALGO
  /// An LLM reads the market and the participant's prompt and decides. FLT Pro
  /// only.
  AI
}

/// Who can see and activate an offering.
enum AlgorithmVisibility {
  /// FLT-authored, shown to everyone.
  FLT
  /// A participant's private offering — only its creator can activate it.
  PRIVATE
  /// Published by a participant: live for everyone, and the creator earns a
  /// share of the fees it generates.
  PUBLIC
  /// Published, awaiting operator review before it may go PUBLIC.
  PENDING_REVIEW
}

/// How an Algo offering computes its signal.
enum AlgorithmStrategyType {
  /// One of the built-in deterministic strategies.
  BUILTIN
  /// A vote over several built-in strategies ("mix").
  COMPOSITE
  /// A participant-written expression in the restricted strategy language.
  CUSTOM
}

/// A trading algorithm FLT offers for sale.
model TradingAlgorithm {
  id String @id
  /// URL-safe identifier used in routes and API paths.
  slug String @unique

  /// Which offering this is — ALGO (deterministic) or AI (LLM-driven).
  kind AlgorithmKind @default(ALGO)

  name        String
  /// One or two lines shown under the name in the marketplace.
  description String
  strategy    AlgorithmStrategy
  /// Strategy parameters (window lengths, thresholds), as JSON so a new
  /// strategy shape needs no new column.
  params Json @default("{}")

  /// The venue symbols this algorithm may trade. Empty is meaningless, so the
  /// service refuses a row with none.
  symbols String[]

  /// The most leverage any order it places may use. Bounded again, at run
  /// time, by the participant's plan and the platform cap.
  maxLeverage Int @default(1)
  /// The most notional (USD) it may hold open per position, as a decimal
  /// string — never a float.
  maxNotionalUsd String
  /// The monthly management fee, in basis points of the participant's
  /// allocated capital. 200 = 2% a month, pro-rated daily (2%/31 per day).
  /// Frictionless: no entry cost; the fee accrues and is taken on exit.
  managementFeeBps Int @default(200)

  /// Whether this offering requires FLT Pro. The AI trader is Pro-only.
  requiresPro Boolean @default(false)

  /// The AI system prompt (AI offerings only).
  systemPrompt String?
  /// Ready-made prompts offered as buttons — "prompt on rails".
  promptRails Json @default("[]")

  /// A billing period, in days. The fee is pro-rated from it.
  periodDays Int? @default(31)

  isActive   Boolean @default(false)
  isFeatured Boolean @default(false)

  /// Who can see it. FLT offerings are everyone's; PRIVATE is the creator's
  /// own; PUBLIC is a shared, credited offering; PENDING_REVIEW awaits approval.
  visibility AlgorithmVisibility @default(FLT)

  /// The creator's share of the management fee this offering generates, in
  /// basis points. 5000 = 50%. Zero for FLT offerings.
  revenueShareBps Int @default(0)

  /// How the signal is computed — built-in strategy, composition, or expression.
  strategyType AlgorithmStrategyType @default(BUILTIN)
  /// The members of a COMPOSITE strategy.
  composition Json?
  /// The expression of a CUSTOM strategy (restricted DSL).
  expression String?

  /// The participant who authored it, or null for FLT.
  creatorId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator       User?            @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  subscriptions UserAlgorithm[]

  @@index([isActive])
  @@map("trading_algorithms")
}

/// One participant's activation of one offering.
///
/// No entry cost: activation records the capital base and starts the daily
/// accrual; the fee is taken on exit. Reactivating after a cancel reuses the row
/// rather than inserting a second, so `(userId, algorithmId)` stays one row and
/// the runner can never pick up two subscriptions for the same participant and
/// offering.
model UserAlgorithm {
  id String @id

  userId      String
  algorithmId String

  status AlgorithmStatus @default(ACTIVE)

  /// The capital the participant allocated, in USD, as a decimal string. This
  /// is the FEE BASE: the management fee is a percentage of THIS, not of the
  /// leveraged notional the algorithm trades with.
  capitalBase String

  /// Management fee accrued but not yet charged, in USD. Resets on each
  /// settlement; charged on exit and monthly while running.
  accruedFeeUsd Decimal @default(0) @db.Decimal(18, 8)
  /// Running total of creator revenue this subscription has generated for a
  /// published offering's author. Display only; the money is on the ledger.
  creatorEarningsUsd Decimal @default(0) @db.Decimal(18, 8)
  /// When the fee was last accrued up to. The next settlement bills the gap.
  feeAccruedAt DateTime @default(now())

  /// The strategy parameters chosen at activation (ALGO offerings).
  strategyParams Json?
  /// The prompt the participant set (AI offerings).
  prompt String?

  /// The participant's own settings for this subscription: leverage, which of
  /// the offering's markets to trade, trade size, and risk guardrails. Always
  /// bounded by the offering: a setting can narrow what the offering allows,
  /// never widen it. Null means "run the offering as published".
  settings Json?
  /// Why the runner paused this subscription itself, when a guardrail tripped.
  /// Null when paused by the participant, or not paused at all.
  pausedReason String?

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// When the runner last evaluated this subscription. Drives the cadence so a
  /// burst of purchases drains fairly rather than starving the oldest.
  lastRunAt DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  algorithm TradingAlgorithm @relation(fields: [algorithmId], references: [id], onDelete: Restrict)
  runs      AlgorithmRun[]

  @@index([userId, algorithmId])
  @@index([status, lastRunAt])
  @@map("user_algorithms")
}

/// One decision the runner made for a subscription.
///
/// The idempotency and audit record both: which symbol, which signal, and what
/// was (or was not) placed. `signal` plus `decidedAt` is what makes "did the bot
/// already act on this bar" answerable after a crash.
model AlgorithmRun {
  id              String @id
  userAlgorithmId String

  symbol String
  side   PerpSide
  /// The signal that triggered this decision, e.g. "MA_CROSSOVER_LONG".
  signal String

  /// The perp order placed, when one was. Null when the run only evaluated, or
  /// was refused by a guardrail.
  perpOrderId String?
  status      String
  /// Why nothing was placed, when nothing was (the guardrail's name).
  reason String?

  decidedAt DateTime @default(now())

  userAlgorithm UserAlgorithm @relation(fields: [userAlgorithmId], references: [id], onDelete: Cascade)

  @@index([userAlgorithmId, decidedAt])
  @@map("algorithm_runs")
}

/// A creator's share of a management fee a published offering generated.
///
/// One row per fee settlement, deduped on the settlement reference so a retried
/// settlement never pays a creator twice. The money itself is posted to the
/// creator's ledger balance; this is the record of why.
model CreatorEarning {
  id String @id

  /// The offering's author, and the participant whose fee produced this share.
  creatorId        String
  algorithmId      String
  subscriberUserId String

  /// The fee-settlement reference this came from. Unique — idempotent.
  settlementRef String @unique
  amountUsd     Decimal @db.Decimal(18, 8)

  createdAt DateTime @default(now())

  @@index([creatorId, createdAt])
  @@map("creator_earnings")
}

enum FiatWithdrawalMethod {
  EVC
  BANK
  PAYPAL
}

enum FiatWithdrawalStatus {
  /// Asked for. The USDC is reserved on the ledger; nothing has been paid.
  REQUESTED
  /// An operator paid it out and recorded the reference. The reservation is spent.
  PAID
  /// Refused before any payout. The reservation was released.
  REJECTED
}

/// A cash withdrawal: USD paid by an operator to an EVC number, a bank account
/// or a PayPal address, out of FLT's own accounts.
///
/// The participant's USDC is reserved when they ask, so the same balance cannot
/// back a trade and a payout at once. It is spent only when an operator records
/// the payout with a reference — a payout marked done with nothing to check it
/// against is indistinguishable from a mistake.
model FiatWithdrawal {
  id     String @id
  userId String

  method FiatWithdrawalMethod
  asset  String               @default("USDC")

  amountUsd Decimal @db.Decimal(38, 18)
  feeUsd    Decimal @db.Decimal(38, 18)
  netUsd    Decimal @db.Decimal(38, 18)

  payeeName     String
  payeePhone    String?
  payeeEmail    String?
  bankName      String?
  accountNumber String?
  routingNumber String?
  swift         String?
  country       String?

  reference String               @unique
  status    FiatWithdrawalStatus @default(REQUESTED)

  /// The bank, EVC or PayPal transaction reference the operator recorded.
  payoutReference String?
  /// Shown to the participant on a rejection.
  note            String?

  paidAt       DateTime?
  paidById     String?
  rejectedAt   DateTime?
  rejectedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("fiat_withdrawals")
}

/// A request to delete an account. See services/account-deletion.ts.
enum AccountDeletionStatus {
  REQUESTED
  COMPLETED
  REFUSED
}

model AccountDeletionRequest {
  id                      String                @id
  userId                  String
  status                  AccountDeletionStatus @default(REQUESTED)
  /// Restored if an operator refuses the request.
  previousAccountStatus   AccountStatus
  previousTradingDisabled Boolean
  note                    String?
  requestedAt             DateTime              @default(now())
  completedAt             DateTime?
  completedById           String?
  refusedAt               DateTime?
  refusedById             String?
  updatedAt               DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([userId])
  @@map("account_deletion_requests")
}
