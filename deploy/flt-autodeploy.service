[Unit]
Description=Deploy FLT-Exchange if origin/main has moved
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Invoked through bash rather than directly, so the unit does not depend on
# the executable bit surviving the trip from a Windows checkout into git.
ExecStart=/bin/bash /opt/flt-exchange/deploy/auto-deploy.sh
# Root, because the last step restarts systemd services. The script drops to
# the flt user for every repo command itself.
User=root
