[Unit]
Description=FLT Exchange administrative application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=flt
Group=flt
WorkingDirectory=/opt/flt-exchange/apps/admin
EnvironmentFile=/opt/flt-exchange/.env
ExecStart=/opt/flt-exchange/apps/admin/node_modules/.bin/next start --port 3001
Restart=always
RestartSec=5

# The application needs no write access outside its own runtime directory, and
# no access to other users' home directories. A compromised process should not
# be able to read the rest of the machine.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flt-exchange/apps/admin/.next/cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=flt-admin

[Install]
WantedBy=multi-user.target
