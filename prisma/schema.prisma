// FLTCrypto — USD-denominated crypto brokerage.
//
// Money rules:
//   * Every monetary column is NUMERIC(38,18). No floats, anywhere, ever.
//   * Balances are PROJECTIONS. The LedgerEntry table is the source of truth.
//   * LedgerTransaction/LedgerEntry are append-only, enforced by DB triggers
//     installed by the ledger_invariants migration.

generator client {
  provider = "prisma-client-js"
  // driverAdapters routes queries through @prisma/adapter-pg (node-postgres)
  // instead of Prisma's own connection handling. Required for Cloudflare
  // Workers, and harmless on Node. See src/server/db.ts.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum AssetKind {
  FIAT
  CRYPTO
}

enum OrderSide {
  BUY
  SELL
}

enum QuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  EXECUTING
  PARTIALLY_FILLED
  FILLED
  SETTLED
  FAILED
  CANCELLED
  REFUNDED
}

enum DepositStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CREDITED
  FAILED
  EXPIRED
  REVERSED
}

enum WithdrawalKind {
  CRYPTO
  FIAT
}

enum WithdrawalStatus {
  REQUESTED
  AWAITING_CONFIRMATION
  CONFIRMED
  SUBMITTED
  BROADCAST
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum LedgerAccountKind {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  USD_DEPOSIT
  USD_WITHDRAWAL
  CRYPTO_PURCHASE
  CRYPTO_SALE
  BROKERAGE_FEE
  NETWORK_FEE
  PROVIDER_FEE
  CRYPTO_DEPOSIT
  CRYPTO_WITHDRAWAL
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
  REFUND
  REVERSAL
  ADJUSTMENT
  // Treasury sourcing, kept separate from the customer's trade.
  TREASURY_SWAP
  TREASURY_OTC_FILL
  TREASURY_TRANSFER
  GAS_FEE
}

/**
 * How much liquidity an asset really has, and therefore how we are willing to
 * trade it. This is the single most important defence against being destroyed
 * by price impact on a long-tail token.
 */
enum LiquidityTier {
  /// BTC, ETH, SOL, USDC, USDT. Deep liquidity, instant.
  TIER_1
  /// Large caps. Instant, tighter size caps.
  TIER_2
  /// Long tail. Quote on request, manual review.
  TIER_3
  /// Illiquid, high-risk, or known-bad. Never tradable.
  TIER_4
}

enum ExecutionMode {
  INSTANT
  RFQ
  MANUAL
  UNAVAILABLE
}

/// Where an order was actually sourced. Never exposed to the customer.
enum ExecutionVenueKind {
  INVENTORY
  DEX
  OTC
}

enum ExecutionAttemptStatus {
  QUOTED
  REJECTED
  SIMULATING
  SUBMITTED
  FILLED
  FAILED
  SKIPPED
}

enum SwapStatus {
  PENDING
  SIMULATED
  SUBMITTED
  CONFIRMED
  FAILED
  REVERTED
  DROPPED
}

enum ProtocolKind {
  AGGREGATOR
  AMM
  RFQ
  BRIDGE
}

enum ScreeningRisk {
  LOW
  MEDIUM
  HIGH
  SEVERE
  UNKNOWN
}

enum ScreeningDecision {
  ACCEPT
  REVIEW
  REJECT
}

enum ScreeningSubject {
  ADDRESS
  TRANSACTION
}

enum WalletTier {
  HOT
  WARM
  COLD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ProviderKind {
  PAYMENT
  LIQUIDITY
  BLOCKCHAIN
  KYC
  DEX
  SCREENING
}

enum ProviderTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
  PROVIDER
}

enum PaymentAccountStatus {
  ACTIVE
  DISABLED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  kycProfile      KycProfile?
  sessions        Session[]
  paymentAccounts PaymentAccount[]
  wallets         Wallet[]
  quotes          Quote[]
  orders          Order[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  ledgerAccounts  LedgerAccount[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model KycProfile {
  id     String @id
  userId String @unique

  provider               String
  externalVerificationId String?
  status                 KycStatus @default(NOT_STARTED)
  tier                   Int       @default(0)

  fullName    String
  dateOfBirth DateTime
  nationality String
  addressLine String
  city        String
  country     String

  documentType String
  // AES-256-GCM ciphertext. Never stored or logged in plaintext. See src/server/crypto.ts
  documentNumberEncrypted String

  submittedAt     DateTime?
  decidedAt       DateTime?
  rejectionReason String?
  rawResult       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([externalVerificationId])
  @@map("kyc_profiles")
}

model PaymentAccount {
  id       String @id
  userId   String
  provider String
  kind     String
  // For WAAFI this is the MSISDN the customer pays from.
  accountRef String
  label      String?
  status     PaymentAccountStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits Deposit[]

  @@unique([userId, provider, accountRef])
  @@index([userId])
  @@map("payment_accounts")
}

model Wallet {
  id        String   @id
  userId    String
  assetId   String
  network   String
  address   String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       Asset        @relation(fields: [assetId], references: [id])
  withdrawals Withdrawal[]

  @@unique([userId, assetId, address])
  @@index([userId])
  @@map("wallets")
}

// ---------------------------------------------------------------------------
// Assets — fully database driven. Adding an asset is a row, not a deploy.
// ---------------------------------------------------------------------------

model Asset {
  id     String    @id
  symbol String    @unique
  name   String
  kind   AssetKind
  // On-chain decimals (USD=2, BTC=8, ETH=18, SOL=9, USDT/USDC=6).
  decimals Int
  // Rounding scale used when presenting and settling amounts of this asset.
  quoteScale Int
  network    String?

  isActive          Boolean @default(true)
  tradingEnabled    Boolean @default(true)
  withdrawalEnabled Boolean @default(true)

  brokerageFeeBps Int     @default(100)
  minTradeUsd     Decimal @default(1) @db.Decimal(38, 18)
  maxTradeUsd     Decimal @default(10000) @db.Decimal(38, 18)
  minWithdrawal   Decimal @default(0) @db.Decimal(38, 18)

  // --- Liquidity policy ---------------------------------------------------
  // Defaults are deliberately the most restrictive: a newly inserted asset is
  // long-tail and manual until someone consciously promotes it.
  liquidityTier LiquidityTier @default(TIER_3)
  executionMode ExecutionMode @default(MANUAL)
  /// Hard ceiling on acceptable price impact for on-chain execution.
  maxPriceImpactBps Int @default(100)
  /// Largest single order we will source on-chain for this asset.
  maxDexTradeUsd Decimal @default(0) @db.Decimal(38, 18)

  // --- On-chain identity --------------------------------------------------
  chain           String?
  contractAddress String?
  /// True for the chain's gas token (ETH on ethereum, SOL on solana).
  isNativeAsset Boolean @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets           Wallet[]
  quotes            Quote[]
  orders            Order[]
  withdrawals       Withdrawal[]
  ledgerAccounts    LedgerAccount[]
  treasuryTargets   TreasuryTarget[]

  @@index([liquidityTier])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Pricing
// ---------------------------------------------------------------------------

model Quote {
  id      String @id
  userId  String
  assetId String

  side              OrderSide
  fiatAmount        Decimal   @db.Decimal(38, 18)
  cryptoAmount      Decimal   @db.Decimal(38, 18)
  exchangeRate      Decimal   @db.Decimal(38, 18)
  brokerageFee      Decimal   @db.Decimal(38, 18)
  networkFee        Decimal   @default(0) @db.Decimal(38, 18)
  totalCustomerCost Decimal   @db.Decimal(38, 18)

  // Raw venue price before our spread — kept so slippage can be audited.
  providerRate     Decimal @db.Decimal(38, 18)
  providerQuoteRef String?

  /// The minimum the customer will accept. Enforced at execution; an order that
  /// cannot beat this is failed and refunded rather than filled worse.
  minOutputAmount Decimal @default(0) @db.Decimal(38, 18)
  /// Price impact of sourcing this size, as quoted. Shown to the customer.
  priceImpactBps Int @default(0)
  /// Venue the router expected to use. Indicative only; execution may differ.
  indicativeVenue ExecutionVenueKind?

  status     QuoteStatus @default(ACTIVE)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset  @relation(fields: [assetId], references: [id])
  order Order?

  @@index([userId, status])
  @@index([expiresAt])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Orders and trades
// ---------------------------------------------------------------------------

model Order {
  id      String @id
  userId  String
  assetId String
  quoteId String @unique

  side   OrderSide
  status OrderStatus @default(CREATED)

  requestedFiatAmount   Decimal @db.Decimal(38, 18)
  requestedCryptoAmount Decimal @db.Decimal(38, 18)
  filledFiatAmount      Decimal @default(0) @db.Decimal(38, 18)
  filledCryptoAmount    Decimal @default(0) @db.Decimal(38, 18)
  refundedFiatAmount    Decimal @default(0) @db.Decimal(38, 18)

  brokerageFee   Decimal  @default(0) @db.Decimal(38, 18)
  providerFee    Decimal  @default(0) @db.Decimal(38, 18)
  executionPrice Decimal? @db.Decimal(38, 18)

  providerOrderId String?
  idempotencyKey  String  @unique
  failureReason   String?

  // Optimistic lock — every state transition bumps this.
  version Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  executedAt DateTime?
  settledAt  DateTime?

  /// The venue that actually sourced this order. Set at settlement.
  executionVenue ExecutionVenueKind?
  /// Floor the customer was promised. Execution below this must not settle.
  minOutputAmount Decimal? @db.Decimal(38, 18)
  priceImpactBps  Int?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset    Asset     @relation(fields: [assetId], references: [id])
  quote    Quote     @relation(fields: [quoteId], references: [id])
  trades   Trade[]
  deposits Deposit[]
  executionAttempts ExecutionAttempt[]

  @@index([userId, status])
  @@index([status])
  @@index([providerOrderId])
  @@map("orders")
}

model Trade {
  id      String @id
  orderId String

  sequence      Int
  quantity      Decimal @db.Decimal(38, 18)
  executedPrice Decimal @db.Decimal(38, 18)
  fiatValue     Decimal @db.Decimal(38, 18)
  providerFee   Decimal @default(0) @db.Decimal(38, 18)

  providerTradeId String?
  executedAt      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sequence])
  @@index([orderId])
  @@map("trades")
}

// ---------------------------------------------------------------------------
// Money in / money out
// ---------------------------------------------------------------------------

model Deposit {
  id               String  @id
  userId           String
  orderId          String?
  paymentAccountId String?

  provider String
  // USD for WAAFI deposits. Crypto deposits use the asset symbol.
  currency String
  // Gross amount the customer paid.
  amount      Decimal @db.Decimal(38, 18)
  providerFee Decimal @default(0) @db.Decimal(38, 18)
  // amount - providerFee. What we credit to the customer.
  netAmount Decimal @db.Decimal(38, 18)

  status DepositStatus @default(PENDING)

  externalId     String?
  idempotencyKey String  @unique
  reference      String?
  failureReason  String?
  version        Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  creditedAt  DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order?          @relation(fields: [orderId], references: [id])
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id])

  @@unique([provider, externalId])
  @@index([userId, status])
  @@index([status])
  @@map("deposits")
}

model Withdrawal {
  id       String         @id
  userId   String
  kind     WithdrawalKind
  assetId  String?
  walletId String?

  // Gross amount debited from the customer.
  amount Decimal @db.Decimal(38, 18)
  // Fee we charge for handling.
  brokerageFee Decimal @default(0) @db.Decimal(38, 18)
  // Chain or provider cost passed through.
  networkFee Decimal @default(0) @db.Decimal(38, 18)
  // amount - brokerageFee - networkFee. What actually leaves.
  netAmount Decimal @db.Decimal(38, 18)

  destinationAddress String?
  destinationRef     String?
  network            String?

  status WithdrawalStatus @default(REQUESTED)

  provider              String?
  externalId            String?
  txHash                String?
  confirmations         Int     @default(0)
  requiredConfirmations Int     @default(1)

  idempotencyKey String  @unique
  failureReason  String?
  version        Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  submittedAt DateTime?
  completedAt DateTime?

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset          Asset?                   @relation(fields: [assetId], references: [id])
  wallet         Wallet?                  @relation(fields: [walletId], references: [id])
  confirmationCodes WithdrawalConfirmation[]

  @@unique([provider, externalId])
  @@index([userId, status])
  @@index([status])
  @@map("withdrawals")
}

model WithdrawalConfirmation {
  id           String    @id
  withdrawalId String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@map("withdrawal_confirmations")
}

// ---------------------------------------------------------------------------
// Ledger — append-only double entry. See the ledger_invariants migration.
// ---------------------------------------------------------------------------

model LedgerAccount {
  id      String            @id
  code    String
  kind    LedgerAccountKind
  assetId String

  ownerUserId String?
  // ownerUserId, or the literal SYSTEM. Exists because Postgres treats NULLs as
  // distinct in unique indexes, which would otherwise permit duplicate accounts.
  ownerKey String

  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset      Asset              @relation(fields: [assetId], references: [id])
  owner      User?              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  projection BalanceProjection?

  @@unique([ownerKey, assetId, code])
  @@index([ownerUserId])
  @@index([code])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id   String                @id
  type LedgerTransactionType

  // Business object this journal entry accounts for.
  referenceType String
  referenceId   String
  // Set for every transaction. Two attempts to post the same business event
  // collide here rather than double-posting.
  idempotencyKey String @unique

  description String
  metadata    Json?

  occurredAt DateTime
  createdAt  DateTime @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([type])
  @@index([occurredAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String @id
  transactionId String
  accountId     String
  assetId       String

  direction LedgerDirection
  // Always positive. Sign is carried by direction.
  amount Decimal @db.Decimal(38, 18)

  createdAt DateTime @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model BalanceProjection {
  id        String @id
  accountId String @unique

  balance    Decimal @db.Decimal(38, 18)
  entryCount Int     @default(0)

  lastEntryId String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("balance_projections")
}

// ---------------------------------------------------------------------------
// Provider I/O, idempotency, webhooks, audit
// ---------------------------------------------------------------------------

model ProviderTransaction {
  id           String       @id
  provider     String
  providerKind ProviderKind
  operation    String

  idempotencyKey String                    @unique
  externalId     String?
  status         ProviderTransactionStatus @default(PENDING)

  referenceType String?
  referenceId   String?

  requestHash     String
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  latencyMs   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, operation])
  @@index([externalId])
  @@index([referenceType, referenceId])
  @@map("provider_transactions")
}

model WebhookEvent {
  id       String @id
  provider String
  // The provider's own event identifier. The unique index below is the replay guard.
  externalEventId String
  eventType       String?

  signatureValid Boolean
  status         WebhookStatus @default(RECEIVED)

  rawBody String
  headers Json

  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalEventId])
  @@index([provider, status])
  @@map("webhook_events")
}

model IdempotencyRecord {
  id       String  @id
  key      String
  userId   String?
  endpoint String

  requestHash String
  status      IdempotencyStatus @default(IN_PROGRESS)

  responseStatus Int?
  responseBody   Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@unique([endpoint, key])
  @@index([userId])
  @@map("idempotency_records")
}

model AuditLog {
  id          String    @id
  actorType   ActorType
  actorUserId String?

  action     String
  entityType String
  entityId   String?

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitBucket {
  id        String   @id
  key       String   @unique
  tokens    Decimal  @db.Decimal(38, 18)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// On-chain execution
//
// The premise: customers always trade against our inventory, and SOURCING that
// inventory (DEX swap, OTC fill, or existing stock) is a separate concern with
// its own records. That separation is what lets the venue change without the
// customer-facing behaviour or the customer's accounting changing at all.
// ---------------------------------------------------------------------------

/**
 * Protocol whitelist. The execution layer refuses to interact with any contract
 * that does not have an approved row here — there is no "just this once" path.
 */
model Protocol {
  id   String       @id
  slug String       @unique
  name String
  kind ProtocolKind
  chain String

  /// The contract we actually call. Null for off-chain aggregator APIs.
  routerAddress String?

  isApproved Boolean   @default(false)
  approvedAt DateTime?
  approvedBy String?

  /// Due-diligence record. Reviewed before approval, re-reviewed on upgrade.
  auditUrl        String?
  hasUpgradeableAdmin Boolean @default(true)
  exploitHistory  Json?
  reviewNotes     String?

  /// Per-trade ceiling for this protocol, independent of the asset's own cap.
  maxTradeUsd Decimal @default(0) @db.Decimal(38, 18)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swaps             SwapTransaction[]
  executionAttempts ExecutionAttempt[]

  @@index([chain, isApproved])
  @@map("protocols")
}

/**
 * Treasury wallets, split by tier so the whole inventory is never behind one key.
 * Limits here are enforced by src/services/treasury.ts before any outbound call.
 */
model TreasuryWallet {
  id      String     @id
  tier    WalletTier
  chain   String
  address String
  label   String

  /// MPC/custody provider holding the key material. Never a raw key in this system.
  custodian String

  isActive Boolean @default(true)

  /// Policy caps, in USD. Zero means "no outbound permitted".
  maxPerTxUsd    Decimal @default(0) @db.Decimal(38, 18)
  maxDailyOutUsd Decimal @default(0) @db.Decimal(38, 18)
  /// Above this, a human must approve even if within the caps.
  manualApprovalAboveUsd Decimal @default(0) @db.Decimal(38, 18)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swaps SwapTransaction[]

  @@unique([chain, address])
  @@index([tier, isActive])
  @@map("treasury_wallets")
}

/// Desired inventory level per asset. Drives rebalancing, not per-trade routing.
model TreasuryTarget {
  id      String @id
  assetId String @unique

  targetUsd Decimal @db.Decimal(38, 18)
  /// Below this, the rebalancer wants to buy more.
  minUsd Decimal @db.Decimal(38, 18)
  /// Above this, we are carrying more inventory risk than intended.
  maxUsd Decimal @db.Decimal(38, 18)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("treasury_targets")
}

/**
 * Best-execution record: one row per venue the router considered, in order,
 * including the ones it rejected and why.
 *
 * This is what makes "we got the customer the best available price" an
 * auditable claim rather than an assertion.
 */
model ExecutionAttempt {
  id      String @id
  orderId String
  sequence Int

  venueKind ExecutionVenueKind
  venueName String
  protocolId String?

  /// What we asked for.
  requestedAmount Decimal @db.Decimal(38, 18)
  requestedAsset  String

  /// What the venue said it would deliver, and the floor we would accept.
  quotedOutput Decimal? @db.Decimal(38, 18)
  minOutput    Decimal? @db.Decimal(38, 18)
  actualOutput Decimal? @db.Decimal(38, 18)

  priceImpactBps Int?
  protocolFee    Decimal? @db.Decimal(38, 18)
  gasFeeNative   Decimal? @db.Decimal(38, 18)
  gasFeeUsd      Decimal? @db.Decimal(38, 18)
  /// Total cost the router compared venues on: output net of every fee.
  netOutput Decimal? @db.Decimal(38, 18)

  /// The route the venue proposed. Opaque to business logic; kept for audit.
  route Json?

  status        ExecutionAttemptStatus @default(QUOTED)
  failureReason String?
  externalRef   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  latencyMs   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  protocol Protocol? @relation(fields: [protocolId], references: [id])
  swap     SwapTransaction?

  @@unique([orderId, sequence])
  @@index([orderId])
  @@index([venueKind, status])
  @@map("execution_attempts")
}

/**
 * An on-chain swap. Separate from ExecutionAttempt because a swap has a life of
 * its own: it can be simulated, submitted, replaced, reverted, or dropped, and
 * its outcome may be unknown for a long time.
 */
model SwapTransaction {
  id String @id

  executionAttemptId String? @unique
  treasuryWalletId   String?
  protocolId         String

  chain String

  fromSymbol String
  toSymbol   String
  amountIn   Decimal @db.Decimal(38, 18)
  /// The floor. Enforced on-chain by the router call, not just in our code.
  minAmountOut Decimal  @db.Decimal(38, 18)
  amountOut    Decimal? @db.Decimal(38, 18)

  txHash      String?
  blockNumber Int?
  gasUsed     Decimal? @db.Decimal(38, 18)
  gasFeeNative Decimal? @db.Decimal(38, 18)

  /// Whether this went through protected/private submission rather than the
  /// public mempool. False is a deliberate, recorded choice.
  privateSubmission Boolean @default(false)

  status        SwapStatus @default(PENDING)
  failureReason String?

  /// Simulation result captured before submission. A swap that fails simulation
  /// is never submitted.
  simulation Json?

  idempotencyKey String @unique
  deadline       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  confirmedAt DateTime?

  executionAttempt ExecutionAttempt? @relation(fields: [executionAttemptId], references: [id])
  protocol         Protocol          @relation(fields: [protocolId], references: [id])
  treasuryWallet   TreasuryWallet?   @relation(fields: [treasuryWalletId], references: [id])

  @@unique([chain, txHash])
  @@index([status])
  @@map("swap_transactions")
}

/**
 * Blockchain-analytics result for an address or transaction.
 *
 * Cached with an expiry: risk is not a permanent property of an address, and a
 * stale ACCEPT is how tainted funds get in.
 */
model ScreeningResult {
  id      String           @id
  subject String
  subjectType ScreeningSubject
  chain   String

  provider   String
  risk       ScreeningRisk
  score      Int?
  categories Json
  decision   ScreeningDecision

  rawResult Json?

  screenedAt DateTime  @default(now())
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject, subjectType])
  @@index([decision])
  @@map("screening_results")
}

/**
 * A human decision gate. Used for large withdrawals, new treasury destinations,
 * and tier-3 manual quotes.
 */
model ManualApproval {
  id String @id

  entityType String
  entityId   String
  reason     String

  /// USD value at stake, for triage.
  valueUsd Decimal? @db.Decimal(38, 18)

  status     ApprovalStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
  @@map("manual_approvals")
}
